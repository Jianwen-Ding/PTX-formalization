// expect: initializers are allowed for all types except .f16, .f16x2 and .pred
// 5.4.4 (reported under .isacheck)
.version 9.4
.target sm_90
.address_size 64
.isacheck ;
.global .f16 gh = 0x3c00;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o; .reg .b32 %r;

    ld.param.u64 %o, [po];
    mov.u32 %r, 1;
    st.global.u32 [%o], %r;
    ret;
}
.buffer O .u32 [1];
.launch k <<< 1, 1 >>> (O);
