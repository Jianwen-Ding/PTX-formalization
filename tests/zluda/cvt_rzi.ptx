// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/cvt_rzi.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry cvt_rzi(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .f32 	    temp1;
    .reg .f32 	    temp2;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.f32          temp1, [in_addr];
    ld.f32          temp2, [in_addr+4];
    cvt.rzi.f32.f32 temp1, temp1;
    cvt.rzi.f32.f32 temp2, temp2;
    st.f32          [out_addr], temp1;
    st.f32          [out_addr+4], temp2;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 205, 204, 92, 193, 102, 102, 78, 65 };
.buffer OUT .u8 [8];
.launch cvt_rzi <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 0, 0, 80, 193, 0, 0, 64, 65 };
