// expect: misaligned global vector access of 8 bytes
// red.v2.f32 is one 8-byte access and needs 8-byte alignment (6.4.1), under .ub strict
.version 8.1
.target sm_90
.address_size 64
.ub strict ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o; .reg .f32 %a<4>, %d<4>;
    ld.param.u64 %o, [po];
    mov.f32 %a0, 0f3F800000; mov.f32 %a1, 0f40000000; mov.f32 %a2, 0f40400000; mov.f32 %a3, 0f40800000;
    atom.global.v4.f32.add {%d0, %d1, %d2, %d3}, [%o], {%a0, %a1, %a2, %a3};
    red.global.v2.f32.add [%o+20], {%a0, %a1};
    ret;
}
.buffer O .f32 = { 1.0, 1.0, 1.0, 1.0, 5.0, 6.0, 0.0, 0.0 };
.launch k <<< 1, 1 >>> (O);
