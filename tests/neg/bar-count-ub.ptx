// expect: barrier thread count is not a multiple of the warp size
// 9.7.14.1: the thread count must be a multiple of the warp size (reported under .ub strict)
.version 8.0
.target sm_90
.address_size 64
.ub strict ;
.visible .entry k(.param .u64 po)
{
    .reg .u32 %r; .reg .b64 %o;
    ld.param.u64 %o, [po];
    mov.u32 %r, 0;
    bar.sync %r, 48;
    st.global.u32 [%o], 1;
    ret;
}
.buffer O .u32 [1];
.launch k <<< 1, 32 >>> (O);
