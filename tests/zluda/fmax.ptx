// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/fmax.ptx;
// inputs/outputs from its mod.rs test table.
.version 7.0
.target sm_80
.address_size 64

.visible .entry fmax(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .f16       temp1;
    .reg .f16       temp2;
    .reg .f16       result1;
    .reg .f16       result2;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.b16          temp1, [in_addr];
    ld.b16          temp2, [in_addr+2];
	max.f16         result1, temp2, temp1;
    st.b16          [out_addr], result1;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 0, 0, 0, 126 };
.buffer OUT .u8 [2];
.launch fmax <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 0, 0 };
