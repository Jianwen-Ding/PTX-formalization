// expect: cp.async.bulk.tensor: the starting coordinates of a .global.shared::cta copy must be non-negative
// "Starting co-ordinates for Bounding Box (tensorCoords) must be non-negative" for .global.shared::cta (9.7.9.26.5.1), under .ub strict
// TMA: tensor-map tile loads (plain, 128B-swizzled, out-of-bounds zero fill), tile store with clipping, tile reduce-add.
.version 8.6
.target sm_90
.address_size 64
.ub strict ;

.visible .entry k(.param .u64 ptmA, .param .u64 ptmB, .param .u64 ptmW, .param .u64 ptmR, .param .u64 po)
{
    .reg .b64 %tA, %tB, %tW, %tR, %o, %mb, %st, %t, %sa, %oo; .reg .b32 %tid, %buf32, %buf2, %buf3, %bar32, %x; .reg .pred %q, %w;
    .shared .align 1024 .b8 bufA[1024];
    .shared .align 1024 .b8 bufB[1024];
    .shared .align 1024 .b8 bufC[1024];
    .shared .align 8 .b64 bar;
    ld.param.u64 %tA, [ptmA]; ld.param.u64 %tB, [ptmB]; ld.param.u64 %tW, [ptmW]; ld.param.u64 %tR, [ptmR]; ld.param.u64 %o, [po];
    mov.u32 %tid, %tid.x;
    setp.eq.u32 %q, %tid, 0;
    mov.u64 %mb, bar;
    mov.u32 %bar32, bar;
    mov.u32 %buf32, bufA; mov.u32 %buf2, bufB; mov.u32 %buf3, bufC;
    @%q mbarrier.init.shared.b64 [%mb], 1;
    bar.sync 0;
    @%q mbarrier.arrive.expect_tx.shared.b64 %st, [%mb], 384;                         // 3 loads x 128 bytes
    @%q cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes [%buf32], [%tA, {4, 2}], [%bar32];
    @%q cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes [%buf2], [%tB, {4, 2}], [%bar32];
    @%q cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes [%buf3], [%tA, {12, 6}], [%bar32];
    @%q mbarrier.try_wait.parity.shared.b64 %w, [%mb], 0;
    bar.sync 0;
    // dump the three images
    mul.wide.u32 %t, %tid, 4;
    mov.u64 %sa, bufA; add.u64 %sa, %sa, %t;
    add.u64 %oo, %o, %t;
    mov.u32 %x, 0;
    mov.u64 %sa, bufA; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+0]; st.global.b32 [%oo+0], %x;
    mov.u64 %sa, bufA; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+128]; st.global.b32 [%oo+128], %x;
    mov.u64 %sa, bufA; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+256]; st.global.b32 [%oo+256], %x;
    mov.u64 %sa, bufA; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+384]; st.global.b32 [%oo+384], %x;
    mov.u64 %sa, bufA; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+512]; st.global.b32 [%oo+512], %x;
    mov.u64 %sa, bufA; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+640]; st.global.b32 [%oo+640], %x;
    mov.u64 %sa, bufA; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+768]; st.global.b32 [%oo+768], %x;
    mov.u64 %sa, bufA; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+896]; st.global.b32 [%oo+896], %x;
    mov.u64 %sa, bufB; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+0]; st.global.b32 [%oo+1024], %x;
    mov.u64 %sa, bufB; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+128]; st.global.b32 [%oo+1152], %x;
    mov.u64 %sa, bufB; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+256]; st.global.b32 [%oo+1280], %x;
    mov.u64 %sa, bufB; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+384]; st.global.b32 [%oo+1408], %x;
    mov.u64 %sa, bufB; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+512]; st.global.b32 [%oo+1536], %x;
    mov.u64 %sa, bufB; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+640]; st.global.b32 [%oo+1664], %x;
    mov.u64 %sa, bufB; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+768]; st.global.b32 [%oo+1792], %x;
    mov.u64 %sa, bufB; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+896]; st.global.b32 [%oo+1920], %x;
    mov.u64 %sa, bufC; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+0]; st.global.b32 [%oo+2048], %x;
    mov.u64 %sa, bufC; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+128]; st.global.b32 [%oo+2176], %x;
    mov.u64 %sa, bufC; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+256]; st.global.b32 [%oo+2304], %x;
    mov.u64 %sa, bufC; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+384]; st.global.b32 [%oo+2432], %x;
    mov.u64 %sa, bufC; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+512]; st.global.b32 [%oo+2560], %x;
    mov.u64 %sa, bufC; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+640]; st.global.b32 [%oo+2688], %x;
    mov.u64 %sa, bufC; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+768]; st.global.b32 [%oo+2816], %x;
    mov.u64 %sa, bufC; add.u64 %sa, %sa, %t; ld.shared.b32 %x, [%sa+896]; st.global.b32 [%oo+2944], %x;
    // stores from image A: plain tile store to W at (2,1), then reduce-add into R at (14,5)
    bar.sync 0;
    @%q cp.async.bulk.tensor.2d.global.shared::cta.tile.bulk_group [%tW, {-2, 1}], [%buf32];
    @%q cp.reduce.async.bulk.tensor.2d.global.shared::cta.add.tile.bulk_group [%tR, {14, 5}], [%buf32];
    @%q cp.async.bulk.commit_group;
    @%q cp.async.bulk.wait_group 0;
    ret;
}
