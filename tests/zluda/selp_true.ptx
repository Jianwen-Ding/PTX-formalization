// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/selp_true.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry selp_true(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .u16 	    temp1;
    .reg .u16 	    temp2;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.u16          temp1, [in_addr];
    ld.u16          temp2, [in_addr + 2];
    selp.u16   		temp1, temp1, temp2, 1;
    st.u16          [out_addr], temp1;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 100, 0, 200, 0 };
.buffer OUT .u8 [2];
.launch selp_true <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 100, 0 };
