// expect: architecture-specific
.version 8.6
.target sm_100
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o; .reg .b32 %r<4>; .reg .pred %p;
    ld.param.u64 %o, [po];
    tcgen05.fence::before_thread_sync;
    st.global.u32 [%o], %r0;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 1 >>> (OUT);
