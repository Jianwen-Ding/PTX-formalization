// expect: instruction needs PTX ISA 9.4
// the .multicast::cluster::32b forms are introduced in PTX ISA 9.4 (9.4 9.7.15.16); .version 9.3 is reported under .isacheck
.version 9.3
.target sm_90
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 po)
{
 .reg .b64 %o, %st, %st2, %mb, %g, %x; .reg .b32 %r<16>; .reg .pred %p, %q, %c;
 .shared .align 8 .b64 bar[4];
 .global .align 8 .b64 gbar[1];
 ld.param.u64 %o, [po];
 mov.u64 %mb, bar;
 cvta.shared.u64 %g, %mb;
mbarrier.init.shared.b64 [%mb], 1;
mov.u32 %r1, 1; mbarrier.arrive.multicast::cluster::32b.shared::cluster.b64 _, [%mb], %r1;
 st.global.v4.b32 [%o], {%r10,%r10,%r10,%r10};
 ret;
}
.buffer O .u32 [8];
.launch k <<< 1, 1 >>> (O);
.expect O .u32 = {};
