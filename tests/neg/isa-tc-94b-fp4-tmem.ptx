// expect: FP4 matrix A in Tensor Memory has no container with Dense K = 64
// .kind::mxf8f6f4 dense K = 64 with an E2M1 A in tensor memory: Table 68 lists FP4 with Dense K 32 only (PTX ISA 9.4 9.7.18.10.4.3), under .isacheck
.version 9.4
.target sm_107f
.address_size 64
.isacheck ;
.visible .entry k()
{
    .reg .b32 %r<6>; .reg .b64 %dA, %dB;
    mov.u32 %r1, 0; mov.u32 %r2, 256; mov.u32 %r3, 2290221696; mov.u32 %r4, 300; mov.u32 %r5, 310; mov.b64 %dA, 0; mov.b64 %dB, 0;
    tcgen05.mma.cta_group::1.kind::mxf8f6f4.block_scale.block32 [%r1], [%r2], %dB, %r3, [%r4], [%r5], 1;
    ret;
}
.launch k <<< 1, 1 >>> ();
