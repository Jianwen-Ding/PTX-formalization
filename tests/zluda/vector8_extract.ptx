// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/vector8_extract.ptx;
// inputs/outputs from its mod.rs test table.
.version 8.8
.target sm_120
.address_size 64

.visible .entry vector8_extract(
    .param .u64 input_p,
    .param .u64 output_p
)
{
    .reg .u64           in_addr;
    .reg .u64           out_addr;
    .reg .u16           temp<8>;

	ld.param.u64    in_addr, [input_p];
    ld.param.u64    out_addr, [output_p];

    ld.global.v8.u8     {temp0, temp1, temp2, temp3, temp4, temp5, temp6, temp7}, [in_addr];
    mov.v8.u16          {temp4, temp5, temp6, temp7, temp0, temp1, temp2, temp3}, {temp3, temp4, temp5, temp6, temp7, temp0, temp1, temp2};
    st.global.v8.u8     [out_addr], {temp0, temp1, temp2, temp3, temp4, temp5, temp6, temp7};
    ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 1, 2, 3, 4, 5, 6, 7, 8 };
.buffer OUT .u8 [8];
.launch vector8_extract <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 8, 1, 2, 3, 4, 5, 6, 7 };
