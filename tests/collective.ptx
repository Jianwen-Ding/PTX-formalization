// Tests the warp-collective rendezvous infrastructure through the internal
// `coll_test` instructions (sum / first over a membermask) and the
// %lanemask_* special registers.
.version 8.0
.target sm_80
.address_size 64

.visible .entry colltest(.param .u64 p_out)
{
    .reg .pred  %p<3>;
    .reg .b32   %r<24>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [p_out];
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd2, %r1, 24;
    add.s64         %rd3, %rd1, %rd2;           // 6 words per thread

    // full-warp sum of (tid + 1): each warp sums its own lanes
    add.u32         %r2, %r1, 1;
    coll_test.sum.u32 %r3, %r2, 0xFFFFFFFF;
    st.global.u32   [%rd3+0], %r3;

    // collective inside a loop: three instances of the same (kind, mask)
    mov.u32         %r4, 0;
    mov.u32         %r5, 0;
$L_loop:
    coll_test.sum.u32 %r6, %r4, 0xFFFFFFFF;     // sum of 0+1+2 per lane = lanes*iter
    add.u32         %r5, %r5, %r6;
    add.u32         %r4, %r4, 1;
    setp.lt.u32     %p1, %r4, 3;
    @%p1 bra        $L_loop;
    st.global.u32   [%rd3+4], %r5;

    // subset mask: only the even lanes take part (and %r1 is even there)
    and.b32         %r7, %r1, 1;
    setp.ne.u32     %p2, %r7, 0;
    @%p2 bra        $L_skip;
    coll_test.first.u32 %r8, %r2, 0x55555555;   // a of the lowest even lane
    st.global.u32   [%rd3+8], %r8;
$L_skip:
    mov.u32         %r9, %lanemask_eq;
    mov.u32         %r10, %lanemask_lt;
    mov.u32         %r11, %lanemask_gt;
    st.global.u32   [%rd3+12], %r9;
    add.u32         %r12, %r10, %r11;           // lt + gt = 0xFFFFFFFF - eq
    st.global.u32   [%rd3+16], %r12;
    mov.u32         %r13, %lanemask_ge;
    mov.u32         %r14, %lanemask_le;
    xor.b32         %r15, %r13, %r14;           // ge ^ le = all but eq... = ~(eq)  (see expected)
    st.global.u32   [%rd3+20], %r15;
    ret;
}

.buffer O .u32 [384];
.launch colltest <<< 1, 64 >>> (O);
.expect O .u32 = { 528, 96, 1, 1, 4294967294, 4294967294, 528, 96, 0, 2, 4294967293, 4294967293, 528, 96, 1, 4, 4294967291, 4294967291, 528, 96, 0, 8, 4294967287, 4294967287, 528, 96, 1, 16, 4294967279, 4294967279, 528, 96, 0, 32, 4294967263, 4294967263, 528, 96, 1, 64, 4294967231, 4294967231, 528, 96, 0, 128, 4294967167, 4294967167, 528, 96, 1, 256, 4294967039, 4294967039, 528, 96, 0, 512, 4294966783, 4294966783, 528, 96, 1, 1024, 4294966271, 4294966271, 528, 96, 0, 2048, 4294965247, 4294965247, 528, 96, 1, 4096, 4294963199, 4294963199, 528, 96, 0, 8192, 4294959103, 4294959103, 528, 96, 1, 16384, 4294950911, 4294950911, 528, 96, 0, 32768, 4294934527, 4294934527, 528, 96, 1, 65536, 4294901759, 4294901759, 528, 96, 0, 131072, 4294836223, 4294836223, 528, 96, 1, 262144, 4294705151, 4294705151, 528, 96, 0, 524288, 4294443007, 4294443007, 528, 96, 1, 1048576, 4293918719, 4293918719, 528, 96, 0, 2097152, 4292870143, 4292870143, 528, 96, 1, 4194304, 4290772991, 4290772991, 528, 96, 0, 8388608, 4286578687, 4286578687, 528, 96, 1, 16777216, 4278190079, 4278190079, 528, 96, 0, 33554432, 4261412863, 4261412863, 528, 96, 1, 67108864, 4227858431, 4227858431, 528, 96, 0, 134217728, 4160749567, 4160749567, 528, 96, 1, 268435456, 4026531839, 4026531839, 528, 96, 0, 536870912, 3758096383, 3758096383, 528, 96, 1, 1073741824, 3221225471, 3221225471, 528, 96, 0, 2147483648, 2147483647, 2147483647, 1552, 96, 33, 1, 4294967294, 4294967294, 1552, 96, 0, 2, 4294967293, 4294967293, 1552, 96, 33, 4, 4294967291, 4294967291, 1552, 96, 0, 8, 4294967287, 4294967287, 1552, 96, 33, 16, 4294967279, 4294967279, 1552, 96, 0, 32, 4294967263, 4294967263, 1552, 96, 33, 64, 4294967231, 4294967231, 1552, 96, 0, 128, 4294967167, 4294967167, 1552, 96, 33, 256, 4294967039, 4294967039, 1552, 96, 0, 512, 4294966783, 4294966783, 1552, 96, 33, 1024, 4294966271, 4294966271, 1552, 96, 0, 2048, 4294965247, 4294965247, 1552, 96, 33, 4096, 4294963199, 4294963199, 1552, 96, 0, 8192, 4294959103, 4294959103, 1552, 96, 