// CTA barrier reductions (bar.red), named barriers with thread counts and bar.warp.sync.
.version 8.0
.target sm_80
.address_size 64

.visible .entry bars(.param .u64 po)
{
    .reg .pred  %p<8>;
    .reg .b32   %r<24>;
    .reg .b64   %rd<8>;
    .shared .align 4 .u32 xs[64];

    ld.param.u64    %rd1, [po];
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd2, %r1, 28;
    add.s64         %rd3, %rd1, %rd2;

    rem.u32         %r2, %r1, 3;
    setp.eq.u32     %p1, %r2, 0;
    bar.red.popc.u32 %r3, 0, %p1;                    // number of threads with p1 = (tid % 3 == 0)
    st.global.u32   [%rd3], %r3;
    setp.lt.u32     %p2, %r1, 100;
    bar.red.and.pred %p3, 0, %p2;
    selp.u32        %r4, 1, 0, %p3;
    st.global.u32   [%rd3+4], %r4;
    setp.eq.u32     %p4, %r1, 63;
    bar.red.or.pred %p5, 0, %p4;
    selp.u32        %r5, 1, 0, %p5;
    st.global.u32   [%rd3+8], %r5;
    bar.red.popc.u32 %r6, 0, !%p1;                   // negated predicate source
    st.global.u32   [%rd3+12], %r6;
    setp.ne.u32     %p6, %r1, 40;
    bar.red.and.pred %p7, 0, %p6;
    selp.u32        %r7, 1, 0, %p7;
    st.global.u32   [%rd3+16], %r7;

    // one named barrier per warp, each with 32 participants
    shr.u32         %r8, %r1, 5;
    add.u32         %r9, %r8, 1;
    bar.red.popc.u32 %r10, %r9, 32, %p1;
    st.global.u32   [%rd3+20], %r10;

    // bar.warp.sync with a partial mask: lanes with (lane % 4) < 2 exchange through shared memory
    and.b32         %r11, %r1, 3;
    setp.ge.u32     %p1, %r11, 2;
    mov.u32         %r12, 999;
    @%p1 bra        $L_skip;
    mov.u32         %r13, xs;
    shl.b32         %r14, %r1, 2;
    add.u32         %r15, %r13, %r14;
    st.shared.u32   [%r15], %r1;
    bar.warp.sync   0x33333333;
    xor.b32         %r16, %r1, 1;
    shl.b32         %r17, %r16, 2;
    add.u32         %r18, %r13, %r17;
    ld.shared.u32   %r12, [%r18];
$L_skip:
    st.global.u32   [%rd3+24], %r12;
    ret;
}

.buffer O .u32 [448];
.launch bars <<< 1, 64 >>> (O);
.expect O .u32 = { 22, 1, 1, 42, 0, 11, 1, 22, 1, 1, 42, 0, 11, 0, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 5, 22, 1, 1, 42, 0, 11, 4, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 9, 22, 1, 1, 42, 0, 11, 8, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 13, 22, 1, 1, 42, 0, 11, 12, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 17, 22, 1, 1, 42, 0, 11, 16, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 21, 22, 1, 1, 42, 0, 11, 20, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 25, 22, 1, 1, 42, 0, 11, 24, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 29, 22, 1, 1, 42, 0, 11, 28, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 33, 22, 1, 1, 42, 0, 11, 32, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 37, 22, 1, 1, 42, 0, 11, 36, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 41, 22, 1, 1, 42, 0, 11, 40, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 45, 22, 1, 1, 42, 0, 11, 44, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 49, 22, 1, 1, 42, 0, 11, 48, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 53, 22, 1, 1, 42, 0, 11, 52, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 57, 22, 1, 1, 42, 0, 11, 56, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 61, 22, 1, 1, 42, 0, 11, 60, 22, 1, 1, 42, 0, 11, 999, 22, 1, 1, 42, 0, 11, 999 };
