// tcgen05.fence: sm_100f or higher in the same family from PTX 8.8 (9.7.17.11.1 L35636); sm_103f is in the sm_10x family
.version 8.8
.target sm_103f
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %rd<4>; .reg .b32 %r<16>; .reg .f32 %f<8>; .reg .b16 %h<4>; .reg .pred %p; .shared .b64 mb;
    ld.param.u64 %o, [po];
    mov.u32 %r0, 7;
    tcgen05.fence::before_thread_sync;
    st.global.u32 [%o], %r0;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 1 >>> (OUT);
