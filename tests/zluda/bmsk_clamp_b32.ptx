// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/bmsk_clamp_b32.ptx;
// inputs/outputs from its mod.rs test table.
.version 7.6
.target sm_70
.address_size 64

.visible .entry bmsk_clamp_b32(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .u32       position;
    .reg .u32       width;
    .reg .u32       result;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.u32          position, [in_addr];
	ld.u32          width, [in_addr+4];
	bmsk.clamp.b32  result, position, width;
    st.u32          [out_addr], result;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 24, 0, 0, 0, 12, 0, 0, 0 };
.buffer OUT .u8 [4];
.launch bmsk_clamp_b32 <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 0, 0, 0, 255 };
