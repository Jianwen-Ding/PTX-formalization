// expect: register %zz is not declared
// operands have the types of their declarations (PTX ISA 9.3 6.1): a register that is never declared has no value
.version 8.0
.target sm_80
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .b32 %r1; .reg .b64 %o;
    ld.param.u64 %o, [po];
    add.u32 %r1, %zz, 1;
    st.global.u32 [%o], %r1;
    ret;
}
.buffer OUT .u32 [1];
.launch k <<< 1, 1 >>> (OUT);
