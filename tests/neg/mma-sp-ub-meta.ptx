// expect: mma.sp: metadata index value that is not meaningful
// "0b0000, 0b0101, 0b1010, 0b1111 are invalid values for metadata and will result in undefined behavior" (9.7.15.6.1); metadata 0 under .ub strict
.version 7.1
.target sm_80
.address_size 64
.ub strict ;
.isacheck ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %rd<4>; .reg .b32 %r<16>; .reg .f32 %f<8>; .reg .b16 %h<4>; .reg .pred %p; .shared .b64 mb;
    ld.param.u64 %o, [po];
    mov.u32 %r0, 7;
    mma.sp.sync.aligned.m16n8k16.row.col.f16.f16.f16.f16 {%r1,%r2}, {%r3,%r4}, {%r5,%r6}, {%r7,%r8}, %r9, 0x0;
    st.global.u32 [%o], %r0;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 32 >>> (OUT);
