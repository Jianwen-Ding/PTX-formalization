test Release_acquire_pattern:my_test
desc mixedproxy permit(r1 == 2 && r3 == 0)
init x=0 y=0
thread T0_0_0 cta=0 cluster=0 gpu=0
  st.weak y 1
  st.release.sys x 1
  st.relaxed.sys x 2
thread T0_1_0 cta=1 cluster=0 gpu=0
  r1 = ld.relaxed.sys x
  fence.acq_rel.sys
  r3 = ld.weak y
exists r1==2 && r3==0
expect allowed

test SB_cta:my_test
desc mixedproxy assert(r0 == 2 || r1 == 1)
init x=0 y=0
thread T0_0_0 cta=0 cluster=0 gpu=0
  st.weak x 1
  fence.sc.cta
  r0 = ld.weak y
thread T0_0_1 cta=0 cluster=0 gpu=0
  st.weak y 2
  fence.sc.cta
  r1 = ld.weak x
exists r0!=2 && r1!=1
expect forbidden

test SB_rmw:r2_r4
desc mixedproxy assert(r2 != 0 || r4 != 0)
init x=0 y=0
thread T0_0_0 cta=0 cluster=0 gpu=0
  r1 = atom.acq_rel.gpu.add x 1
  r2 = atom.acq_rel.gpu.add y 1
thread T0_1_0 cta=1 cluster=0 gpu=0
  r3 = atom.acq_rel.gpu.add y 1
  r4 = atom.acq_rel.gpu.add x 1
exists r2==0 && r4==0
expect forbidden

test SB_rmw_2:r2_r3
desc mixedproxy permit(r2 == 0 && r3 == 0)
init x=0 y=0
thread T0_0_0 cta=0 cluster=0 gpu=0
  r1 = atom.acq_rel.gpu.add x 1
  r2 = atom.acq_rel.gpu.add y 1
thread T0_1_0 cta=1 cluster=0 gpu=0
  st.relaxed.gpu y 1
  r3 = ld.relaxed.gpu x
exists r2==0 && r3==0
expect allowed
