// expect: not supported from PTX ISA 2.0 on sm_20 or higher
// mad.f32 needs a rounding modifier from PTX 2.0 on sm_20 and higher (9.7.3.7 L8514)
.version 7.0
.target sm_80
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %rd<4>; .reg .b32 %r<16>; .reg .f32 %f<8>; .reg .b16 %h<4>; .reg .pred %p; .shared .b64 mb;
    ld.param.u64 %o, [po];
    mov.u32 %r0, 7;
    mad.f32 %f0, %f1, %f2, %f3;
    st.global.u32 [%o], %r0;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 1 >>> (OUT);
