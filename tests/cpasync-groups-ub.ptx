// copies to the same location in different cp.async-groups are allowed (9.7.9.26.3.1), checked under .ub strict
.version 8.0
.target sm_90
.address_size 64
.ub strict ;
.visible .entry k(.param .u64 pi, .param .u64 po)
{
    .reg .b64 %i, %o; .reg .b32 %r;
    .shared .align 16 .b8 buf[64];
    ld.param.u64 %i, [pi]; ld.param.u64 %o, [po];
    cp.async.ca.shared.global [buf], [%i], 4;
    cp.async.commit_group;
    cp.async.wait_group 0;
    cp.async.ca.shared.global [buf], [%i+4], 4;
    cp.async.commit_group;
    cp.async.wait_group 0;
    ld.shared.u32 %r, [buf];
    st.global.u32 [%o], %r;
    ret;
}
.buffer I .u32 = { 5, 9 };
.buffer O .u32 [1];
.launch k <<< 1, 1 >>> (I, O);
.expect O .u32 = { 9 };
