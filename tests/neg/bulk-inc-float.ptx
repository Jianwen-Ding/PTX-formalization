// expect: cp.reduce.async.bulk: .inc on floating-point type .f32
// outside the ISA table cp.reduce.async.bulk runs with the natural meaning of the operation, but .inc / .dec have none on floats
.version 8.6
.target sm_90
.address_size 64
.visible .entry k(.param .u64 pg)
{
  .reg .b64 %g; .reg .b32 %buf32;
  .shared .align 128 .b8 buf[64];
  ld.param.u64 %g, [pg]; mov.u32 %buf32, buf;
  cp.reduce.async.bulk.global.shared::cta.bulk_group.inc.f32 [%g], [%buf32], 16;
  cp.async.bulk.commit_group;
  cp.async.bulk.wait_group 0;
  ret;
}
.buffer G .f32 = { 5.0, 0.5, 2.0, -1.0 };
.launch k <<< 1, 1 >>> (G);
