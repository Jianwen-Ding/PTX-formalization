// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/call.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .func (.param.u64 output) incr (.param.u64 input);

.visible .entry call(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .u64 	    temp;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.global.u64   temp, [in_addr];
    .param.u64      incr_in;
    .param.u64      incr_out;
    st.param.b64    [incr_in], temp;
    call (incr_out), incr, (incr_in);
    ld.param.u64    temp, [incr_out];
    st.global.u64   [out_addr], temp;
    ret;
}

.visible .func (.param .u64 output) incr(
    .param .u64 input
)
{
    .reg .u64 	    temp;
    ld.param.u64    temp, [input];
    add.u64         temp, temp, 1;
    st.param.u64    [output], temp;
    ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 1, 0, 0, 0, 0, 0, 0, 0 };
.buffer OUT .u8 [8];
.launch call <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 2, 0, 0, 0, 0, 0, 0, 0 };
