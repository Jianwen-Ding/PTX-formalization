// memory.agx with encodable operands: threadgroup indices in 16-bit registers, no shift on threadgroup accesses
.uni u2 = 4096;
.uni u3 = 0;
.laneid r4;
imadd r5, r4, 3, r22;            // 3*lane + 1000
device_store u32 1 r5, u2_u3, r4, unsigned, 0;
mov r6, 77;
device_load u32 1 r6, u2_u3, r4, unsigned, 0;
mov r7, r6;                      // before `wait` the destination still holds the old value
wait 0;
simd_shuffle_xor r8, r4, 1;
simd_shuffle_down r9, r4, 2;
simd_shuffle_up r10, r4, 3;
threadgroup_store u32 1 r4, r4l, 0;
threadgroup_barrier;
bitop 6 r11, r4, 1;              // lane xor 1
threadgroup_load u32 1 r12, r11l, 0;
wait 0;
device_load u16 2 r13, u2_u3, 2, unsigned, 0;   // the two 16-bit halves at 4096 + (2 << 1): lane 1 stored 1003 there
wait 0;
stop;
.all r22 = 1000;
.run;
.expectlane 5 r6 = 1015;
.expectall r7 = 77;
.expectdev 4116 = 1015;
.expectlane 6 r8 = 7;
.expectlane 6 r9 = 8;
.expectlane 30 r9 = 30;
.expectlane 6 r10 = 3;
.expectlane 1 r10 = 1;
.expectlane 9 r12 = 8;
.expectall r13 = 1003;
.expectall r14 = 0
