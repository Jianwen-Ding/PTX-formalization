// .nv_intermediate_source_section (PTX ISA 9.4 11.5.6): the text between .source_begin and .source_end "may contain
// arbitrary text including newlines" -- here '#', '%', an unbalanced '{' and a '}' -- and .loc_intermediate (11.5.5)
// immediately after a .loc
.version 9.4
.target sm_90
.address_size 64
.isacheck ;
.file 1 "k.cu"
.file 2 "k.tileir"
.nv_intermediate_source_section {
    .code_block {
        .ir_name: "TileIR"
        .sourceFileName: 2
        .source_begin
          %0 = tile.load #map<(d0) -> (d0)> { if (a) {
          }} } // not PTX
        .source_end
    }
}
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o; .reg .b32 %r;
    ld.param.u64 %o, [po];
    .loc 1 3 1
    .loc_intermediate 2 7 1
    mov.u32 %r, 42;
    st.global.u32 [%o], %r;
    ret;
}
.buffer O .u32 [1];
.launch k <<< 1, 1 >>> (O);
.expect O .u32 = { 42 };
