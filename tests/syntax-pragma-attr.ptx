// directives the front end must accept (PTX ISA 9.3): .pragma with a list of strings (11.4.1), a .pragma between a
// kernel's header and its body (example of 11.4.2), .func .attribute(...) (11.3.2, example .unified(0xAB, 0xCD))
.version 8.0
.target sm_80
.address_size 64
.pragma "nounroll", "foo";
.func .attribute(.unified(0xAB, 0xCD)) (.reg .b32 r) bar(.reg .b32 a)
{
    add.u32 r, a, 1;
    ret;
}
.visible .entry k(.param .u64 po)
.pragma "nounroll";
{
    .reg .b64 %o; .reg .b32 %r<3>;
    .pragma "nounroll", "unroll";
    ld.param.u64 %o, [po];
    mov.u32 %r1, 41;
    call (%r2), bar, (%r1);
    st.global.u32 [%o], %r2;
    ret;
}
.buffer OUT .u32 [1];
.launch k <<< 1, 1 >>> (OUT);
.expect OUT .u32 = { 42 };
