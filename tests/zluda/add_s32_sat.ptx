// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/add_s32_sat.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry add_s32_sat(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .s32 	    temp<4>;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.s32          temp0, [in_addr];
    ld.s32          temp1, [in_addr+4];
	add.sat.s32		temp2, temp0, temp1;
	add.s32         temp3, temp0, temp1;
    st.s32          [out_addr], temp2;
    st.s32          [out_addr+4], temp3;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 0, 0, 0, 128, 255, 255, 255, 255 };
.buffer OUT .u8 [8];
.launch add_s32_sat <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 0, 0, 0, 128, 255, 255, 255, 127 };
