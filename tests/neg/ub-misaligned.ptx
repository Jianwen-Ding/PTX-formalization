// expect: misaligned global access
.version 8.0
.target sm_90
.address_size 64
.ub strict ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %p; .reg .b32 %r<4>;
    ld.param.u64 %o, [po];
    add.u64 %p, %o, 2;
    mov.u32 %r0, 7;
    st.global.u32 [%p], %r0;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 1 >>> (OUT);
