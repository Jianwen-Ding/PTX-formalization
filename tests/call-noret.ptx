// a call may leave out the return values ("Input arguments and return values are optional", PTX ISA 9.3 9.7.13): the
// results are discarded (the callee's st.param to its return parameter goes to a fresh slot); side effects still happen
.version 8.0
.target sm_80
.address_size 64
.func (.param .b32 r) f(.param .b64 a)
{
    .reg .b64 %p; .reg .b32 %x;
    ld.param.u64 %p, [a];
    st.global.u32 [%p], 5;
    mov.u32 %x, 9;
    st.param.b32 [r], %x;
    ret;
}
.func (.reg .b32 q) g(.reg .b64 p)
{
    st.global.u32 [p+4], 6;
    mov.u32 q, 3;
    ret;
}
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o;
    ld.param.u64 %o, [po];
    { .param .b64 pa; st.param.b64 [pa], %o; call f, (pa); }
    call g, (%o);
    ret;
}
.buffer OUT .u32 [2];
.launch k <<< 1, 1 >>> (OUT);
.expect OUT .u32 = { 5, 6 };
