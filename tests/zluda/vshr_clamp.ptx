// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/vshr_clamp.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry vshr_clamp(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .u32 	    temp<4>;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.u32          temp1, [in_addr];
    ld.u32          temp2, [in_addr+4];
    ld.u32          temp3, [in_addr+8];
	vshr.u32.u32.u32.clamp.add  temp0, temp1, temp2, temp3;
    st.u32                      [out_addr], temp0;
	vshr.u32.u32.u32.clamp.add  temp0, temp1, 32, temp3;
    st.u32                      [out_addr+4], temp0;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 144, 165, 45, 142, 16, 0, 0, 0, 112, 159, 138, 36 };
.buffer OUT .u8 [8];
.launch vshr_clamp <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 157, 45, 139, 36, 112, 159, 138, 36 };
