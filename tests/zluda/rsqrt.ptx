// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/rsqrt.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry rsqrt(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	        in_addr;
    .reg .u64 	        out_addr;
    .reg .f64 	        temp1;

	ld.param.u64 	    in_addr, [input];
    ld.param.u64 	    out_addr, [output];

    ld.f64              temp1, [in_addr];
	rsqrt.approx.f64    temp1, temp1;
    st.f64              [out_addr], temp1;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 0, 0, 0, 0, 0, 0, 208, 63 };
.buffer OUT .u8 [8];
.launch rsqrt <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 0, 0, 0, 0, 0, 0, 0, 64 };
