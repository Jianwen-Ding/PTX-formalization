// Exhaustive schedule exploration with a warp collective in the middle:
// 3 lanes each add their tid to a global counter, rendezvous on a sum, then
// store it.  Every interleaving must produce the same final memory.
.version 8.0
.target sm_80
.address_size 64

.global .align 4 .u32 total;
.global .align 4 .u32 snap[4];

.visible .entry k()
{
    .reg .b32  %r<8>;
    .reg .b64  %rd<3>;
    mov.u32         %r1, %tid.x;
    atom.global.add.u32 %r2, [total], %r1;
    coll_test.sum.u32 %r3, %r1, 7;            // 0+1+2 = 3 in every lane
    mul.wide.u32    %rd1, %r1, 4;
    mov.u64         %rd2, snap;
    add.s64         %rd2, %rd2, %rd1;
    st.global.u32   [%rd2], %r3;
    ret;
}

.launch k <<< 1, 3 >>> ();
.expect total .u32 = { 3 };
.expect snap .u32 = { 3, 3, 3, 0 };
