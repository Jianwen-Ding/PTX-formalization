.version 8.0
.target sm_90
.address_size 64
.global .align 4 .u32 g;
.visible .entry k(.param .u64 po)
{
    .shared .align 4 .b32 s;
    .local .align 4 .b32 l;
    .reg .pred %p<8>; .reg .b32 %r<10>; .reg .b64 %o, %ag, %as, %al, %agen;
    ld.param.u64 %o, [po];
    mov.u64 %ag, g; mov.u64 %as, s; mov.u64 %al, l;
    cvta.global.u64 %ag, %ag; cvta.shared.u64 %as, %as; cvta.local.u64 %al, %al;
    isspacep.global %p0, %ag; selp.u32 %r0, 1, 0, %p0;
    isspacep.shared %p1, %ag; selp.u32 %r1, 1, 0, %p1;
    isspacep.shared %p2, %as; selp.u32 %r2, 1, 0, %p2;
    isspacep.local %p3, %al; selp.u32 %r3, 1, 0, %p3;
    isspacep.global %p4, %al; selp.u32 %r4, 1, 0, %p4;
    mov.u32 %r5, 77;
    st.global.u32 [g], %r5;
    ldu.global.u32 %r6, [g];
    st.global.u32 [%o], %r0; st.global.u32 [%o+4], %r1; st.global.u32 [%o+8], %r2;
    st.global.u32 [%o+12], %r3; st.global.u32 [%o+16], %r4; st.global.u32 [%o+20], %r6;
    ret;
}
.buffer OUT .u32 [6];
.launch k <<< 1, 1 >>> (OUT);
.expect OUT .u32 = { 1, 0, 1, 1, 0, 77 };
