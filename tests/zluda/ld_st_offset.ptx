// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/ld_st_offset.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry ld_st_offset(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .u32 	    temp1;
    .reg .u32 	    temp2;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.u32          temp1, [in_addr];
    ld.u32          temp2, [in_addr+4];
    st.u32          [out_addr], temp2;
    st.u32          [out_addr+4], temp1;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 1, 0, 0, 0, 2, 0, 0, 0 };
.buffer OUT .u8 [8];
.launch ld_st_offset <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 2, 0, 0, 0, 1, 0, 0, 0 };
