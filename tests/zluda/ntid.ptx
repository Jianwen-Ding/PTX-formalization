// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/ntid.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry ntid(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .u32 	    in_val;
    .reg .u32 	    global_count;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.u32          in_val, [in_addr];
    mov.u32         global_count, %ntid.x;
	add.u32		    in_val, in_val, global_count;
    st.u32          [out_addr], in_val;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 3, 0, 0, 0 };
.buffer OUT .u8 [4];
.launch ntid <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 4, 0, 0, 0 };
