// expect: multimem.ld_reduce: .acc_prec is not valid with .f16x2
// PTX ISA 9.3 9.7.9.15: .acc::f16 applies to the fp8 types only
.version 8.6
.target sm_100a
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 p_mm, .param .u64 p_o)
{
    .reg .b64 %mm, %o; .reg .b32 %r0; .reg .b16 %h0;
    ld.param.u64 %mm, [p_mm]; ld.param.u64 %o, [p_o];
    multimem.ld_reduce.add.acc::f16.f16x2 %r0, [%mm+0];
    st.global.b32 [%o], %r0;
    ret;
}
.buffer D0 .u32 = { 1065353216, 0 };
.buffer D1 .u32 = { 1073741824, 0 };
.multimem MM .size 8 { D0, D1 } ;
.buffer O .u32 [1];
.launch k <<< 1, 1 >>> (MM, O);
