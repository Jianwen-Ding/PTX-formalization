// expect: address_size 32: 64-bit register
// without an .address_size directive the address size is 32 (PTX ISA 11.1.3), so a 64-bit register is not an
// address
.version 8.0
.target sm_90
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o;
    ld.param.u64 %o, [po];
    st.global.u32 [%o], 1;
    ret;
}
.buffer OUT .u32 [1];
.launch k <<< 1, 1 >>> (OUT);
