.version 8.0
.target sm_90
.address_size 64

.func (.param .b32 ret) gcd(.param .b32 pa, .param .b32 pb)
{
    .reg .pred %p; .reg .b32 %r<5>;
    ld.param.b32 %r1, [pa]; ld.param.b32 %r2, [pb];
L:
    setp.eq.u32 %p, %r2, 0;
    @%p bra D;
    rem.u32 %r3, %r1, %r2; mov.u32 %r1, %r2; mov.u32 %r2, %r3;
    bra L;
D:
    st.param.b32 [ret], %r1;
    ret;
}
.visible .entry k(.param .u64 pa, .param .u64 pb, .param .u64 pc)
{
    .reg .b32 %r<6>; .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [pa]; ld.param.u64 %rd2, [pb]; ld.param.u64 %rd3, [pc];
    mov.u32 %r1, %tid.x; mul.wide.u32 %rd4, %r1, 4;
    add.s64 %rd5, %rd1, %rd4; add.s64 %rd6, %rd2, %rd4; add.s64 %rd7, %rd3, %rd4;
    ld.global.u32 %r2, [%rd5]; ld.global.u32 %r3, [%rd6];
    {
        .param .b32 pr; .param .b32 qa; .param .b32 qb;
        st.param.b32 [qa], %r2; st.param.b32 [qb], %r3;
        call (pr), gcd, (qa, qb);
        ld.param.b32 %r4, [pr];
    }
    st.global.u32 [%rd7], %r4;
    ret;
}

.buffer A .u32 = { 167, 26, 168, 119, 10, 27, 2, 122, 60, 115, 96, 11, 76, 60, 31, 13, 49, 154, 150, 50, 20, 96, 132, 46, 115, 155, 67, 199, 200, 171, 2, 28 };
.buffer B .u32 = { 164, 153, 182, 159, 90, 56, 10, 95, 88, 37, 12, 53, 66, 10, 154, 188, 167, 53, 3, 84, 105, 174, 96, 48, 159, 80, 20, 53, 9, 127, 141, 124 };
.buffer C .u32 [32];
.launch k <<< 1, 32 >>> (A, B, C);
.expect C .u32 = { 1, 1, 14, 1, 10, 1, 2, 1, 4, 1, 12, 1, 2, 10, 1, 1, 1, 1, 3, 2, 5, 6, 12, 2, 1, 5, 1, 1, 1, 1, 1, 4 };
