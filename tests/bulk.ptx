// Bulk async copies: global -> shared::cluster with mbarrier completion (+ multicast), shared -> global (cp_mask),
// cp.reduce.async.bulk (add) to global.
.version 8.6
.target sm_90
.address_size 64

.visible .entry k(.param .u64 pi, .param .u64 po, .param .u64 pg, .param .u64 pg2) .reqnctapercluster 2, 1, 1
{
    .reg .b64 %i, %o, %g, %g2, %mb, %st, %t, %sa, %oo; .reg .b32 %tid, %rank, %x0, %x1, %buf32, %bar32, %ctaid, %dst32; .reg .pred %q, %is0, %r1p, %w, %w1, %w0;
    .shared .align 128 .b8 buf[256];
    .shared .align 8 .b64 bar;
    ld.param.u64 %i, [pi]; ld.param.u64 %o, [po]; ld.param.u64 %g, [pg]; ld.param.u64 %g2, [pg2];
    mov.u32 %tid, %tid.x;
    mov.u32 %rank, %cluster_ctarank;
    mov.u32 %ctaid, %ctaid.x;
    setp.eq.u32 %q, %tid, 0;
    setp.eq.u32 %is0, %rank, 0;
    setp.eq.u32 %r1p, %rank, 1;
    mov.u64 %mb, bar;
    @%q mbarrier.init.shared.b64 [%mb], 1;
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    @%q mbarrier.arrive.expect_tx.shared.b64 %st, [%mb], 256;
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    mov.u32 %buf32, buf;
    mov.u32 %bar32, bar;
    and.pred %w, %q, %is0;
    @%w cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes.multicast::cluster [%buf32], [%i], 256, [%bar32], 3;
    @%q mbarrier.try_wait.parity.shared.b64 %w, [%mb], 0;
    bar.sync 0;
    mul.wide.u32 %t, %tid, 4;
    mov.u64 %sa, buf; add.u64 %sa, %sa, %t;
    mul.wide.u32 %oo, %ctaid, 256; add.u64 %oo, %oo, %t; add.u64 %oo, %oo, %o;
    ld.shared.b32 %x0, [%sa]; ld.shared.b32 %x1, [%sa+128];
    st.global.b32 [%oo], %x0; st.global.b32 [%oo+128], %x1;
    // bulk_group: CTA 1 reduces 64 bytes of its buffer into g (add.u32); CTA 0 copies 32 bytes with a byte mask into g2
    and.pred %w1, %q, %r1p;
    @%w1 cp.reduce.async.bulk.global.shared::cta.bulk_group.add.u32 [%g], [%buf32], 64;
    and.pred %w0, %q, %is0;
    @%w0 cp.async.bulk.global.shared::cta.bulk_group.cp_mask [%g2], [%buf32], 32, 255;
    @%q cp.async.bulk.commit_group;
    @%q cp.async.bulk.wait_group 0;
    ret;
}
.buffer I .u32 = { 5, 18, 31, 44, 57, 70, 83, 96, 109, 122, 135, 148, 161, 174, 187, 200, 213, 226, 239, 252, 265, 278, 291, 304, 317, 330, 343, 356, 369, 382, 395, 408, 421, 434, 447, 460, 473, 486, 499, 512, 525, 538, 551, 564, 577, 590, 603, 616, 629, 642, 655, 668, 681, 694, 707, 720, 733, 746, 759, 772, 785, 798, 811, 824 };
.buffer O .u32 [128];
.buffer G .u32 = { 1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008, 1009, 1010, 1011, 1012, 1013, 1014, 1015 };
.buffer G2 .u32 = { 2863311530, 2863311530, 2863311530, 2863311530, 2863311530, 2863311530, 2863311530, 2863311530 };
.launch k <<< 2, 32 >>> (I, O, G, G2);
.expect O .u32 = { 5, 18, 31, 44, 57, 70, 83, 96, 109, 122, 135, 148, 161, 174, 187, 200, 213, 226, 239, 252, 265, 278, 291, 304, 317, 330, 343, 356, 369, 382, 395, 408, 421, 434, 447, 460, 473, 486, 499, 512, 525, 538, 551, 564, 577, 590, 603, 616, 629, 642, 655, 668, 681, 694, 707, 720, 733, 746, 759, 772, 785, 798, 811, 824, 5, 18, 31, 44, 57, 70, 83, 96, 109, 122, 135, 148, 161, 174, 187, 200, 213, 226, 239, 252, 265, 278, 291, 304, 317, 330, 343, 356, 369, 382, 395, 408, 421, 434, 447, 460, 473, 486, 499, 512, 525, 538, 551, 564, 577, 590, 603, 616, 629, 642, 655, 668, 681, 694, 707, 720, 733, 746, 759, 772, 785, 798, 811, 824 };
.expect G .u32 = { 1005, 1019, 1033, 1047, 1061, 1075, 1089, 1103, 1117, 1131, 1145, 1159, 1173, 1187, 1201, 1215 };
.expect G2 .u32 = { 5, 18, 2863311530, 2863311530, 57, 70, 2863311530, 2863311530 };
