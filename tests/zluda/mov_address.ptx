// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/mov_address.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry mov_address(
	.param .u64 input,
	.param .u64 output
)
{
    .local .b8  __local_depot0[8];
	.reg .u64   temp;

    mov.u64     temp, __local_depot0;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 173, 222, 0, 0, 0, 0, 0, 0 };
.buffer OUT .u8 [8];
.launch mov_address <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 0, 0, 0, 0, 0, 0, 0, 0 };
