// expect: kernel declares both .reqntid and .maxntid
// "The .reqntid directive cannot be used in conjunction with the .maxntid directive" (11.4.3), reported under .isacheck
.version 8.0
.target sm_90
.address_size 64
.isacheck ;
.global .align 4 .u32 r;
.visible .entry k() .maxntid 64, 4, 1 .reqntid 32, 2, 1
{
    st.global.u32 [r], 1;
    ret;
}
.launch k <<< 1, (32, 2) >>> ();
