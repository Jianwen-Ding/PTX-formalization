// cp.async: full copy, src-size zero fill, ignore-src predicate, commit/wait, mbarrier completion (.noinc).
.version 8.6
.target sm_90
.address_size 64

.visible .entry k(.param .u64 pi, .param .u64 po)
{
    .reg .b64 %i, %o, %g, %s, %sh, %t, %mb, %stt; .reg .b32 %tid, %nb, %x<4>, %y; .reg .pred %p, %ig, %q, %w;
    .shared .align 16 .b8 A[512];
    .shared .align 16 .b8 B[512];
    .shared .align 16 .b8 C[512];
    .shared .align 8 .b64 bar;
    ld.param.u64 %i, [pi]; ld.param.u64 %o, [po];
    mov.u32 %tid, %tid.x;
    setp.eq.u32 %q, %tid, 0;
    mov.u64 %mb, bar;
    @%q mbarrier.init.shared.b64 [%mb], 96;       // 32 threads x 3 noinc cp.async.mbarrier.arrive
    bar.sync 0;
    mul.wide.u32 %t, %tid, 16;
    add.u64 %g, %i, %t;
    mov.u64 %s, A; add.u64 %s, %s, %t;
    cp.async.cg.shared.global [%s], [%g], 16;
    cp.async.mbarrier.arrive.noinc.shared.b64 [%mb];
    mov.u64 %s, B; add.u64 %s, %s, %t;
    mov.u32 %y, 6;
    cp.async.ca.shared.global [%s], [%g], 16, %y;
    cp.async.mbarrier.arrive.noinc.shared.b64 [%mb];
    and.b32 %nb, %tid, 1;
    setp.ne.u32 %ig, %nb, 0;
    mov.u64 %s, C; add.u64 %s, %s, %t;
    cp.async.cg.shared.global [%s], [%g], 16, %ig;
    cp.async.mbarrier.arrive.noinc.shared.b64 [%mb];
    cp.async.commit_group;
    cp.async.wait_group 0;
    mbarrier.try_wait.parity.shared.b64 %w, [%mb], 0;
    bar.sync 0;
    add.u32 %nb, %tid, 1;
    and.b32 %nb, %nb, 31;
    mul.wide.u32 %t, %nb, 16;
    mul.wide.u32 %g, %tid, 48;
    add.u64 %g, %g, %o;
    mov.u64 %s, A; add.u64 %s, %s, %t;
    ld.shared.b32 %x0, [%s]; ld.shared.b32 %x1, [%s+4]; ld.shared.b32 %x2, [%s+8]; ld.shared.b32 %x3, [%s+12];
    st.global.b32 [%g], %x0; st.global.b32 [%g+4], %x1; st.global.b32 [%g+8], %x2; st.global.b32 [%g+12], %x3;
    mov.u64 %s, B; add.u64 %s, %s, %t;
    ld.shared.b32 %x0, [%s]; ld.shared.b32 %x1, [%s+4]; ld.shared.b32 %x2, [%s+8]; ld.shared.b32 %x3, [%s+12];
    st.global.b32 [%g+16], %x0; st.global.b32 [%g+20], %x1; st.global.b32 [%g+24], %x2; st.global.b32 [%g+28], %x3;
    mov.u64 %s, C; add.u64 %s, %s, %t;
    ld.shared.b32 %x0, [%s]; ld.shared.b32 %x1, [%s+4]; ld.shared.b32 %x2, [%s+8]; ld.shared.b32 %x3, [%s+12];
    st.global.b32 [%g+32], %x0; st.global.b32 [%g+36], %x1; st.global.b32 [%g+40], %x2; st.global.b32 [%g+44], %x3;
    ret;
}
