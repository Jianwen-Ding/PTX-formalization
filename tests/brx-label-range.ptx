// .branchtargets with a label range: "The list of labels may use the compact, shorthand syntax for enumerating a range of
// labels having a common prefix" (11.3.1, example `ts: .branchtargets N<5>;`); brx.idx with index 2 goes to N2
.version 8.0
.target sm_90
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o; .reg .b32 %i, %v;
    ld.param.u64 %o, [po];
    mov.u32 %i, 2;
    ts: .branchtargets N<3>;
    brx.idx %i, ts;
N0: mov.u32 %v, 10; bra D;
N1: mov.u32 %v, 11; bra D;
N2: mov.u32 %v, 12; bra D;
D:  st.global.u32 [%o], %v;
    ret;
}
.buffer O .u32 [1];
.launch k <<< 1, 1 >>> (O);
.expect O .u32 = { 12 };
