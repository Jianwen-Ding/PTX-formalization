.version 8.0
.target sm_90
.address_size 64

.visible .entry k(.param .u64 pin, .param .u64 pout)
{
    .reg .pred %p; .reg .b32 %r<10>; .reg .b64 %rd<6>;
    ld.param.u64 %rd1, [pin]; ld.param.u64 %rd2, [pout];
    mov.u32 %r1, %tid.x; mul.wide.u32 %rd3, %r1, 4; add.s64 %rd4, %rd1, %rd3; add.s64 %rd5, %rd2, %rd3;
    ld.global.u32 %r2, [%rd4];
    and.b32 %r3, %r1, 31;
    mov.u32 %r4, 1;
LOOP:
    shfl.sync.up.b32 %r5|%p, %r2, %r4, 0, 0xffffffff;
    setp.ge.u32 %p, %r3, %r4;
    @%p add.u32 %r2, %r2, %r5;
    shl.b32 %r4, %r4, 1;
    setp.lt.u32 %p, %r4, 32;
    @%p bra LOOP;
    st.global.u32 [%rd5], %r2;
    ret;
}

.buffer IN .u32 = { 90, 30, 14, 20, 33, 6, 23, 25, 39, 80, 39, 67, 97, 26, 37, 57, 64, 86, 22, 34, 44, 2, 32, 4, 1, 2, 93, 64, 70, 24, 65, 60, 31, 57, 13, 84, 83, 55, 84, 63, 69, 50, 64, 39, 88, 27, 29, 43, 25, 90, 93, 81, 17, 51, 44, 6, 16, 1, 9, 80, 94, 32, 55, 20 };
.buffer OUT .u32 [64];
.launch k <<< 1, 64 >>> (IN, OUT);
.expect OUT .u32 = { 90, 120, 134, 154, 187, 193, 216, 241, 280, 360, 399, 466, 563, 589, 626, 683, 747, 833, 855, 889, 933, 935, 967, 971, 972, 974, 1067, 1131, 1201, 1225, 1290, 1350, 31, 88, 101, 185, 268, 323, 407, 470, 539, 589, 653, 692, 780, 807, 836, 879, 904, 994, 1087, 1168, 1185, 1236, 1280, 1286, 1302, 1303, 1312, 1392, 1486, 1518, 1573, 1593 };
