// expect: multimem.ld_reduce: .vec and .e4m3x2 is not a valid combination
// PTX ISA 9.3 9.7.9.15: "the size of the specified type along with .vec must equal either 32-bits or 64-bits or 128-bits"; .e4m3x2 alone is 16 bits
.version 8.6
.target sm_100a
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 p_mm, .param .u64 p_o)
{
    .reg .b64 %mm, %o; .reg .b32 %r0; .reg .b16 %h0;
    ld.param.u64 %mm, [p_mm]; ld.param.u64 %o, [p_o];
    multimem.ld_reduce.max.e4m3x2 %h0, [%mm+0]; mov.b32 %r0, 0;
    st.global.b32 [%o], %r0;
    ret;
}
.buffer D0 .u32 = { 1065353216, 0 };
.buffer D1 .u32 = { 1073741824, 0 };
.multimem MM .size 8 { D0, D1 } ;
.buffer O .u32 [1];
.launch k <<< 1, 1 >>> (MM, O);
