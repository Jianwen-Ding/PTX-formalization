// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/nanosleep.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_70
.address_size 64

.visible .entry nanosleep(
	.param .u64 input,
	.param .u64 output
)
{
    // TODO: check if there's some way of testing that it actually sleeps
    nanosleep.u32 1;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 0, 0, 0, 0, 0, 0, 0, 0 };
.buffer OUT .u8 [8];
.launch nanosleep <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 0, 0, 0, 0, 0, 0, 0, 0 };
