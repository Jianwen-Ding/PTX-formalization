// expect: wmma.load: stride below the default of the shape
// wmma.load: "Specifying a value lower than the default value results in undefined behavior" (9.7.15.4.3), under .ub strict
.version 8.0
.target sm_90
.address_size 64
.ub strict ;
.visible .entry k(.param .u64 pa)
{
    .reg .b64 %pa; .reg .b32 %A<8>;
    ld.param.u64 %pa, [pa];
    wmma.load.a.sync.aligned.row.m16n16k16.global.f16 {%A0, %A1, %A2, %A3, %A4, %A5, %A6, %A7}, [%pa], 8;
    ret;
}
.buffer A .u16 [512];
.launch k <<< 1, 32 >>> (A);
