.version 8.0
.target sm_90
.address_size 64

.visible .entry k(.param .u64 pin, .param .u64 pout)
{
    .shared .align 4 .b32 tile[72];
    .reg .b32 %r<10>; .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [pin]; ld.param.u64 %rd2, [pout];
    mov.u32 %r1, %tid.x; shr.u32 %r2, %r1, 3; and.b32 %r3, %r1, 7;
    mul.wide.u32 %rd3, %r1, 4; add.s64 %rd4, %rd1, %rd3; ld.global.u32 %r4, [%rd4];
    mad.lo.u32 %r5, %r2, 9, %r3;                    // tile[row][col], pitch 9
    mul.wide.u32 %rd5, %r5, 4; mov.u64 %rd6, tile; add.s64 %rd6, %rd6, %rd5;
    st.shared.u32 [%rd6], %r4;
    bar.sync 0;
    mad.lo.u32 %r6, %r3, 9, %r2;                    // tile[col][row]
    mul.wide.u32 %rd5, %r6, 4; mov.u64 %rd6, tile; add.s64 %rd6, %rd6, %rd5;
    ld.shared.u32 %r7, [%rd6];
    add.s64 %rd7, %rd2, %rd3; st.global.u32 [%rd7], %r7;
    ret;
}

.buffer IN .u32 = { 110, 47, 138, 127, 196, 204, 228, 221, 159, 11, 65, 16, 217, 242, 250, 0, 37, 200, 239, 229, 127, 55, 114, 79, 77, 55, 234, 43, 20, 0, 64, 119, 19, 155, 65, 128, 223, 57, 50, 36, 153, 98, 198, 133, 114, 0, 5, 154, 235, 142, 161, 124, 243, 120, 126, 14, 210, 157, 28, 11, 99, 255, 215, 41 };
.buffer OUT .u32 [64];
.launch k <<< 1, 64 >>> (IN, OUT);
.expect OUT .u32 = { 110, 159, 37, 77, 19, 153, 235, 210, 47, 11, 200, 55, 155, 98, 142, 157, 138, 65, 239, 234, 65, 198, 161, 28, 127, 16, 229, 43, 128, 133, 124, 11, 196, 217, 127, 20, 223, 114, 243, 99, 204, 242, 55, 0, 57, 0, 120, 255, 228, 250, 114, 64, 50, 5, 126, 215, 221, 0, 79, 119, 36, 154, 14, 41 };
