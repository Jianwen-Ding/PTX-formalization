// expect: write to the read-only special register %laneid
// special registers are predefined, read-only variables (PTX ISA 9.3 chapter 10)
.version 8.0
.target sm_80
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .b32 %r1; .reg .b64 %o;
    ld.param.u64 %o, [po];
    mov.u32 %laneid, 9;
    mov.u32 %r1, %laneid;
    st.global.u32 [%o], %r1;
    ret;
}
.buffer OUT .u32 [1];
.launch k <<< 1, 1 >>> (OUT);
