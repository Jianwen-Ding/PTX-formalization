// cvt.rn.bf16.f32: .bf16 destination needs PTX 7.0 / sm_80 (9.7.9.22 L15278, L15317); the 7.8/sm_90 row is cvt.bf16.{u8,...,bf16} only
.version 7.0
.target sm_80
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %rd<4>; .reg .b32 %r<16>; .reg .f32 %f<8>; .reg .b16 %h<4>; .reg .pred %p; .shared .b64 mb;
    ld.param.u64 %o, [po];
    mov.u32 %r0, 7;
    cvt.rn.bf16.f32 %h0, %f0;
    st.global.u32 [%o], %r0;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 1 >>> (OUT);
