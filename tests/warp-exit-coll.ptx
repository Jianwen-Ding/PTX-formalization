// Warp collectives with an exited lane (PTX ISA 9.3): shfl.sync, vote.sync, match.sync and redux.sync wait for "all
// non-exited threads corresponding to membermask" and reduce / compare across the non-exited threads ("d is set to mask
// corresponding to non-exited threads in membermask" for match.all); bar.warp.sync is a barrier and "Barriers exclusively
// waiting on arrivals from exited threads are always released" (exit).  Lane 31 exits: in the first launch before the
// others arrive, in the second only after lanes 0..30 wait at bar.warp.sync.
// Results per lane: ballot, redux.add of 1, vote.all, match.all mask, match.all predicate, shfl.idx from lane 0.
.version 8.0
.target sm_80
.address_size 64
.visible .entry k(.param .u64 po, .param .u32 pdelay)
{
    .reg .b32 %r<16>; .reg .pred %p<8>; .reg .b64 %rd<8>;
    ld.param.u64 %rd2, [po];
    ld.param.u32 %r9, [pdelay];
    mov.u32 %r1, %tid.x;
    setp.eq.u32 %p1, %r1, 31;
    @!%p1 bra GO;
    mov.u32 %r10, 0;
D:  setp.lt.u32 %p2, %r10, %r9;          // lane 31: %r9 global loads before exit
    @!%p2 bra X;
    ld.global.u32 %r11, [%rd2];
    add.u32 %r10, %r10, 1;
    bra D;
X:  exit;
GO:
    mov.u32 %r13, 1;
    mov.u32 %r14, 7;
    setp.ne.u32 %p3, %r1, 99;
    bar.warp.sync 0xffffffff;
    vote.sync.ballot.b32 %r2, %p3, 0xffffffff;
    redux.sync.add.u32 %r3, %r13, 0xffffffff;
    vote.sync.all.pred %p4, %p3, 0xffffffff;
    selp.u32 %r4, 1, 0, %p4;
    match.all.sync.b32 %r5|%p5, %r14, 0xffffffff;
    selp.u32 %r6, 1, 0, %p5;
    add.u32 %r12, %r1, 100;
    shfl.sync.idx.b32 %r7, %r12, 0, 31, 0xffffffff;
    mul.wide.u32 %rd3, %r1, 24;
    add.s64 %rd5, %rd2, %rd3;
    st.global.v2.u32 [%rd5], {%r2, %r3};
    st.global.v2.u32 [%rd5+8], {%r4, %r5};
    st.global.v2.u32 [%rd5+16], {%r6, %r7};
    ret;
}
.buffer O .u32 [186];
.buffer O2 .u32 [186];
.launch k <<< 1, 32 >>> (O, 0);
.launch k <<< 1, 32 >>> (O2, 5);
.expect O .u32 = { 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100 };
.expect O2 .u32 = { 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100, 2147483647, 31, 1, 2147483647, 1, 100 };
