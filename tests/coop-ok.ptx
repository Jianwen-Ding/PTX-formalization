// cooperative launch that fits: all CTAs resident
.version 8.0
.target sm_90
.address_size 64
.occupancy 4 ;
.global .align 4 .u32 counter;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %a; .reg .b32 %c, %tk; .reg .pred %p;
    ld.param.u64 %o, [po];
    mov.u32 %c, %ctaid.x;
    mov.u32 %tk, %tid.x;
    setp.ne.u32 %p, %tk, 0;
    @%p ret;
    atom.global.add.u32 %tk, [counter], 1;
    mul.wide.u32 %a, %c, 4;
    add.u64 %a, %o, %a;
    st.global.u32 [%a], %tk;
    ret;
}

.buffer OUT .u32 [4];
.cooplaunch k <<< 4, 8 >>> (OUT);
.expect OUT .u32 = { 0, 1, 2, 3 };
