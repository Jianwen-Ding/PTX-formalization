// expect: not supported from PTX ISA 6.4 on sm_70 or higher
// vote without .sync: not supported from PTX 6.4 for sm_70 or higher (9.7.14.9 L21631)
.version 7.0
.target sm_80
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %rd<4>; .reg .b32 %r<16>; .reg .f32 %f<8>; .reg .b16 %h<4>; .reg .pred %p; .shared .b64 mb;
    ld.param.u64 %o, [po];
    mov.u32 %r0, 7;
    vote.all.pred %p, %p;
    st.global.u32 [%o], %r0;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 1 >>> (OUT);
