// expect: unknown target architecture sm_90f
// there is no sm_90f (11.1.2)
.version 9.3
.target sm_90f
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %rd<4>; .reg .b32 %r<16>; .reg .f32 %f<8>; .reg .b16 %h<4>; .reg .pred %p; .shared .b64 mb;
    ld.param.u64 %o, [po];
    mov.u32 %r0, 7;
    add.u32 %r1, %r0, %r0;
    st.global.u32 [%o], %r0;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 1 >>> (OUT);
