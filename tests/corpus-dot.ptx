    ld.global.f32 %f1, [%rd5]; ld.global.f32 %f2, [%rd6];
    mul.f32 %f3, %f1, %f2;
    mov.u32 %r2, 16;
LOOP:
    shfl.sync.down.b32 %f4, %f3, %r2, 31, 0xffffffff;
    add.f32 %f3, %f3, %f4;
    shr.u32 %r2, %r2, 1;
    setp.ne.u32 %p, %r2, 0;
    @%p bra LOOP;
    and.b32 %r3, %r1, 31;
    setp.ne.u32 %p, %r3, 0;
    @%p bra END;
    atom.global.add.f32 %f5, [%rd3], %f3;
END:
    ret;
}

