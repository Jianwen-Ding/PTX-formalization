// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/fma_f16x2.ptx;
// inputs/outputs from its mod.rs test table.
.version 7.0
.target sm_80
.address_size 64

.visible .entry fma_f16x2(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .b32 	    temp1;
    .reg .b32 	    temp2;
    .reg .b32 	    temp3;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.b32          temp1, [in_addr];
    ld.b32          temp2, [in_addr+4];
    ld.b32          temp3, [in_addr+8];
	fma.rn.f16x2	temp1, temp1, temp2, temp3;
    st.b32          [out_addr], temp1;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 64, 64, 0, 64, 128, 64, 64, 64, 64, 64, 160, 64 };
.buffer OUT .u8 [4];
.launch fma_f16x2 <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 232, 70, 144, 70 };
