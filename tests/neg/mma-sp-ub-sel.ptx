// expect: mma.sp: sparsity selector outside the values of the shape
// m16n8k32 .f16: "the sparsity selector must be either 0 (threads T0, T1) or 1 (threads T2, T3); any other value results
// in an undefined behavior" (9.7.15.6.1), under .ub strict
.version 7.1
.target sm_80
.address_size 64
.ub strict ;
.visible .entry k()
{
    .reg .b32 %r<16>;
    mov.b32 %r9, 0x44444444;
    mma.sp.sync.aligned.m16n8k32.row.col.f16.f16.f16.f16 {%r1,%r2}, {%r3,%r4,%r5,%r6}, {%r7,%r8,%r10,%r11}, {%r12,%r13}, %r9, 0x2;
    ret;
}
.launch k <<< 1, 32 >>> ();
