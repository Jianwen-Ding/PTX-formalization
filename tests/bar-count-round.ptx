// a thread count that is not a multiple of 32 counts whole warps in the default mode (9.7.14.1)
.version 8.0
.target sm_90
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .u32 %r; .reg .b64 %o;
    ld.param.u64 %o, [po];
    mov.u32 %r, 0;
    bar.sync %r, 48;
    st.global.u32 [%o], 1;
    ret;
}
.buffer O .u32 [1];
.launch k <<< 1, 64 >>> (O);
.expect O .u32 = { 1 };
