// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/tanh.ptx;
// inputs/outputs from its mod.rs test table.
.version 7.0
.target sm_75
.address_size 64

.visible .entry tanh(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	        in_addr;
    .reg .u64 	        out_addr;
    .reg .f32 	        temp1;

	ld.param.u64 	    in_addr, [input];
    ld.param.u64 	    out_addr, [output];

    ld.f32              temp1, [in_addr];
	tanh.approx.f32     temp1, temp1;
    st.f32              [out_addr], temp1;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 0, 0, 128, 127 };
.buffer OUT .u8 [4];
.launch tanh <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 0, 0, 128, 63 };
