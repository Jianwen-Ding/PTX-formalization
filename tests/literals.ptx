// integer literals (PTX ISA 9.3, 4.5.1): octal 0{octal digit}+, the U suffix on decimal literals; integer constants
// used as predicates are True when non-zero (4.5.3)
.version 8.0
.target sm_80
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %d<4>; .reg .b32 %r<4>; .reg .pred %p<3>;
    ld.param.u64 %o, [po];
    mov.u64 %d0, 017;
    mov.u64 %d1, 42U;
    mov.u64 %d2, 0;
    mov.pred %p1, 2;
    selp.u64 %d2, 7, 9, %p1;
    mov.pred %p2, 0x10;
    selp.u32 %r1, 1, 0, %p2;
    st.global.v2.u64 [%o], {%d0, %d1};
    st.global.u64 [%o+16], %d2;
    st.global.u32 [%o+24], %r1;
    ret;
}
.buffer OUT .u32 [8];
.launch k <<< 1, 1 >>> (OUT);
.expect OUT .u32 = { 15, 0, 42, 0, 7, 0, 1, 0 };
