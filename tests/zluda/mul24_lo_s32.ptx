// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/mul24_lo_s32.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry mul24_lo_s32(
	.param .s64 input,
	.param .s64 output
)
{
	.reg .s64 	    in_addr;
    .reg .s64 	    out_addr;
    .reg .s32 	    temp;
    .reg .s32 	    temp2;
    .reg .s32       temp3;

	ld.param.s64 	in_addr, [input];
    ld.param.s64 	out_addr, [output];

    ld.s32          temp, [in_addr];
    neg.s32         temp2, temp;
	mul24.lo.s32		temp3, temp2, temp;
    st.s32          [out_addr], temp3;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 85, 85, 117, 0 };
.buffer OUT .u8 [4];
.launch mul24_lo_s32 <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 199, 113, 220, 227 };
