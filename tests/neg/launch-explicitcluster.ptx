// expect: .explicitcluster launched without cluster dimensions
// a kernel with .explicitcluster must be launched with cluster dimensions, which this harness only takes from
// .reqnctapercluster (PTX ISA 11.7.2)
.version 8.0
.target sm_90
.address_size 64
.visible .entry k() .explicitcluster { ret; }
.launch k <<< 2, 1 >>> ();
