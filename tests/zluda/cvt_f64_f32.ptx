// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/cvt_f64_f32.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry cvt_f64_f32(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .f32 	    temp_f32;
    .reg .f64 	    temp_f64;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.global.f32   temp_f32, [in_addr];
	cvt.ftz.f64.f32 temp_f64, temp_f32;
    st.f64          [out_addr], temp_f64;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 0, 0, 0, 62 };
.buffer OUT .u8 [8];
.launch cvt_f64_f32 <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 0, 0, 0, 0, 0, 0, 192, 63 };
