// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/vector8.ptx;
// inputs/outputs from its mod.rs test table.
.version 8.8
.target sm_120
.address_size 64

.visible .entry vector8(
    .param .u64 input_p,
    .param .u64 output_p
)
{
    .reg .u64       in_addr;
    .reg .u64       out_addr;
    .reg .u32       dst<8>;
    .reg .u32       temp_scalar;

    ld.param.u64    in_addr, [input_p];
    ld.param.u64    out_addr, [output_p];

   ld.global.v8.u32 {dst0, dst1, dst2, dst3, dst4, dst5, dst6, dst7}, [in_addr];
    mov.b32         temp_scalar, dst7;
    st.u32          [out_addr], temp_scalar;
    ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 1, 0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0, 4, 0, 0, 0, 5, 0, 0, 0, 6, 0, 0, 0, 7, 0, 0, 0, 8, 0, 0, 0 };
.buffer OUT .u8 [4];
.launch vector8 <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 8, 0, 0, 0 };
