// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/sin.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry sin(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .f32       temp;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.f32          temp, [in_addr];
	sin.approx.f32  temp, temp;
    st.f32          [out_addr], temp;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 219, 15, 201, 63 };
.buffer OUT .u8 [4];
.launch sin <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 0, 0, 128, 63 };
