.version 8.0
.target sm_80
.address_size 64
.visible .entry k(.param .u64 po, .param .u64 pt)
{
    .shared .align 4 .b32 s;
    .local .align 4 .b32 l;
    .reg .pred %p<8>; .reg .b32 %r<16>; .reg .b64 %o, %t, %as, %al, %xs, %xl, %xg;
    ld.param.u64 %o, [po];
    ld.param.u64 %t, [pt];
    mov.u64 %as, s; cvta.shared.u64 %as, %as;
    mov.u64 %al, l; cvta.local.u64 %al, %al;
    mov.u32 %r10, 11; st.shared.u32 [s], %r10;
    mov.u32 %r11, 22; st.local.u32 [l], %r11;
    // through memory, so that the compiler cannot see where these addresses come from
    st.volatile.global.u64 [%t], %as;
    st.volatile.global.u64 [%t+8], %al;
    st.volatile.global.u64 [%t+16], %t;
    ld.volatile.global.u64 %xs, [%t];
    ld.volatile.global.u64 %xl, [%t+8];
    ld.volatile.global.u64 %xg, [%t+16];
    isspacep.shared %p0, %xs; selp.u32 %r0, 1, 0, %p0;
    isspacep.global %p1, %xs; selp.u32 %r1, 1, 0, %p1;
    isspacep.local %p2, %xl;  selp.u32 %r2, 1, 0, %p2;
    isspacep.shared %p3, %xl; selp.u32 %r3, 1, 0, %p3;
    isspacep.global %p4, %xg; selp.u32 %r4, 1, 0, %p4;
    isspacep.local %p5, %xg;  selp.u32 %r5, 1, 0, %p5;
    ld.u32 %r6, [%xs];
    ld.u32 %r7, [%xl];
    st.global.u32 [%o], %r0; st.global.u32 [%o+4], %r1; st.global.u32 [%o+8], %r2;
    st.global.u32 [%o+12], %r3; st.global.u32 [%o+16], %r4; st.global.u32 [%o+20], %r5;
    st.global.u32 [%o+24], %r6; st.global.u32 [%o+28], %r7;
    ret;
}
.buffer OUT .u32 [8];
.buffer TMP .u64 [3];
.launch k <<< 1, 1 >>> (OUT, TMP);
.expect OUT .u32 = { 1, 0, 1, 0, 1, 0, 11, 22 };
