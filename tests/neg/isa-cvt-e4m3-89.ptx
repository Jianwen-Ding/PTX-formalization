// expect: needs PTX ISA 8.1
// cvt .e4m3x2 for sm_89 needs PTX 8.1 (9.7.9.22 L15294)
.version 7.8
.target sm_89
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %rd<4>; .reg .b32 %r<16>; .reg .f32 %f<8>; .reg .b16 %h<4>; .reg .pred %p; .shared .b64 mb;
    ld.param.u64 %o, [po];
    mov.u32 %r0, 7;
    cvt.rn.satfinite.e4m3x2.f32 %h0, %f0, %f1;
    st.global.u32 [%o], %r0;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 1 >>> (OUT);
