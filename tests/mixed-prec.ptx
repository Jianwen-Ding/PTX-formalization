// mixed-precision add / mul (PTX ISA 8.6 / 9.4, sm_107f): up-conversion to f32 and rz down-conversion to f16x2 / bf16x2
.version 9.4
.target sm_107f
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %a, %c; .reg .b32 %x, %y, %r0, %r1, %r2; .reg .b16 %h; .reg .f32 %f;
    ld.param.u64 %o, [po];
    mov.b32 %x, 0x3f8ccccd; mov.b32 %y, 0xc0133333;       // 1.1, -2.3
    mov.b64 %a, {%x, %y};
    mov.b32 %x, 0x3fa66666; mov.b32 %y, 0x3f333333;       // 1.3, 0.7
    mov.b64 %c, {%x, %y};
    mul.ftz.rz.f16x2.f32x2.f32x2 %r0, %a, %c;
    mul.rz.bf16x2.f32x2.f32x2 %r1, %a, %c;
    mov.b16 %h, 0x3e00;                                   // 1.5 in f16
    mov.b32 %x, 0x40100000;                               // 2.25
    mov.b32 %f, %x;
    add.f32.f16 %r2, %h, %f;                              // 3.75
    st.global.b32 [%o], %r0;
    st.global.b32 [%o+4], %r1;
    st.global.b32 [%o+8], %r2;
    ret;
}
.buffer OUT .u32 [3];
.launch k <<< 1, 1 >>> (OUT);
.expect OUT .u32 = { 3195026872, 3217964983, 1081081856 };
