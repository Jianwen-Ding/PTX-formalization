// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/shared_variable.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64


.visible .entry shared_variable(
	.param .u64 input,
	.param .u64 output
)
{
    .shared .align 4 .b8    shared_mem1[128];

	.reg .u64 	            in_addr;
    .reg .u64 	            out_addr;
    .reg .u64 	            temp1;
    .reg .u64 	            temp2;

	ld.param.u64 	        in_addr, [input];
    ld.param.u64 	        out_addr, [output];

    ld.global.u64           temp1, [in_addr];
    st.shared.u64           [shared_mem1], temp1;
    ld.shared.u64           temp2, [shared_mem1];
    st.global.u64           [out_addr], temp2;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 1, 2, 0, 0, 0, 0, 0, 0 };
.buffer OUT .u8 [8];
.launch shared_variable <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 1, 2, 0, 0, 0, 0, 0, 0 };
