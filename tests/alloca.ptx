// alloca / stacksave / stackrestore on the per-thread stack; the allocation is freed by ret.
.version 8.6
.target sm_90
.address_size 64

.func (.param .u32 rv) useStack (.param .u32 n)
{
    .reg .u64 p; .reg .u32 t, i; .reg .pred q;
    ld.param.u32 t, [n];
    alloca.u64 p, 64, 16;
    st.u32 [p], t;
    st.u32 [p+4], 5;
    ld.u32 t, [p];
    ld.u32 i, [p+4];
    add.u32 t, t, i;
    st.param.u32 [rv], t;
    ret;
}

.visible .entry k(.param .u64 po)
{
    .reg .u64 %o, %p1, %p2, %p3, %sp; .reg .u32 %a, %b, %c, %e, %f, %res; .reg .pred %q;
    .param .u32 pa; .param .u32 prv;
    ld.param.u64 %o, [po];
    alloca.u64 %p1, 24;
    mov.u32 %a, 111;
    st.u32 [%p1], %a;
    stacksave.u64 %sp;
    alloca.u64 %p2, 40, 32;
    stackrestore.u64 %sp;
    alloca.u64 %p3, 40, 32;
    setp.eq.u64 %q, %p2, %p3;
    selp.u32 %b, 1, 0, %q;                // after stackrestore the next alloca reuses the space
    setp.ne.u64 %q, %p1, %p3;
    selp.u32 %c, 1, 0, %q;
    and.b64 %sp, %p3, 31;
    cvt.u32.u64 %e, %sp;                  // 32-byte alignment
    ld.u32 %f, [%p1];
    mov.u32 %a, 37;
    st.param.u32 [pa], %a;
    call (prv), useStack, (pa);
    ld.param.u32 %res, [prv];
    st.global.u32 [%o], %b;
    st.global.u32 [%o+4], %c;
    st.global.u32 [%o+8], %e;
    st.global.u32 [%o+12], %f;
    st.global.u32 [%o+16], %res;
    ret;
}
.buffer O .u32 [5];
.launch k <<< 1, 1 >>> (O);
.expect O .u32 = { 1, 1, 0, 111, 42 };
