// Thread block clusters: special registers, mapa + distributed shared memory, barrier.cluster.
.version 8.6
.target sm_90
.address_size 64

.visible .entry k(.param .u64 po) .reqnctapercluster 2, 1, 1
{
    .reg .b64 %o, %oo; .reg .pred %p0; .reg .b32 %r<16>, %rank, %nrank, %cid, %peer, %v, %got, %tid;
    .shared .align 4 .b32 slot[2];
    ld.param.u64 %o, [po];
    mov.u32 %tid, %tid.x;
    mov.u32 %rank, %cluster_ctarank;
    mov.u32 %nrank, %cluster_nctarank;
    mov.u32 %cid, %clusterid.x;
    // thread 0 of each CTA writes (cid*100 + rank*10 + 7) into slot[0] of the peer CTA
    setp.eq.u32 %p0, %tid, 0;
    xor.b32 %peer, %rank, 1;
    mad.lo.u32 %v, %cid, 100, 7;
    mad.lo.u32 %v, %rank, 10, %v;
    mov.u32 %r1, slot;
    mapa.shared::cluster.u32 %r2, %r1, %peer;
    @%p0 st.shared::cluster.b32 [%r2], %v;
    // atomically add 1000 to slot[1] of the peer, from thread 0
    @%p0 atom.shared::cluster.add.u32 %r3, [%r2+4], 1000;
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    ld.shared.b32 %got, [slot];
    ld.shared.b32 %r4, [slot+4];
    getctarank.shared::cluster.u32 %r5, %r2;
    // out[ctaid*8 + 0..4]
    mov.u32 %r6, %ctaid.x;
    mul.wide.u32 %oo, %r6, 32;
    add.u64 %oo, %oo, %o;
    @%p0 st.global.b32 [%oo], %got;
    @%p0 st.global.b32 [%oo+4], %r4;
    @%p0 st.global.b32 [%oo+8], %rank;
    @%p0 st.global.b32 [%oo+12], %nrank;
    @%p0 st.global.b32 [%oo+16], %cid;
    @%p0 st.global.b32 [%oo+20], %r5;
    ret;
}
.buffer O .u32 [32];
.launch k <<< 4, 2 >>> (O);
// cta c has rank c%2, cluster c/2; it receives the value written by its peer (rank^1) in the same cluster
.expect O .u32 = { 17, 1000, 0, 2, 0, 1,    0, 0,
                    7, 1000, 1, 2, 0, 0,    0, 0,
                  117, 1000, 0, 2, 1, 1,    0, 0,
                  107, 1000, 1, 2, 1, 0,    0, 0 };
