// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/fma.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry fma(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .f32 	    temp1;
    .reg .f32 	    temp2;
    .reg .f32 	    temp3;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.f32          temp1, [in_addr];
    ld.f32          temp2, [in_addr+4];
    ld.f32          temp3, [in_addr+8];
	fma.rn.f32		temp1, temp1, temp2, temp3;
    st.f32          [out_addr], temp1;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 0, 0, 0, 64, 0, 0, 64, 64, 0, 0, 160, 64 };
.buffer OUT .u8 [4];
.launch fma <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 0, 0, 48, 65 };
