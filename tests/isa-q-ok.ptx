// legal qualifier combinations under .isacheck: add.f32x2 (sm_100 or higher, PTX 8.6), add.u8x4 (PTX 9.2, sm_120f
// or higher in the same family: 9.7.1.1 L5762, so sm_120a and not sm_100a), shfl.sync
.version 9.2
.target sm_120a
.address_size 64
.isacheck ;
.global .align 4 .u32 r;
.visible .entry k()
{
    .reg .b32 %a, %b, %c; .reg .b64 %d<3>;
    mov.b32 %a, 0x01010101; mov.b32 %b, 0x02020202;
    add.u8x4 %c, %a, %b;
    add.f32x2 %d0, %d1, %d2;
    shfl.sync.up.b32 %a, %b, 1, 0, 0xffffffff;
    st.global.u32 [r], %c;
    ret;
}
.launch k <<< 1, 32 >>> ();
.expect r .u32 = { 50529027 };
