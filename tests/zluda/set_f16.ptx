// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/set_f16.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_60
.address_size 64

.visible .entry set_f16(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .b16 	    in16_<2>;
    .reg .b32 	    in32_<2>;
    .reg .b32 	    result<2>;

	ld.param.u64 	    in_addr, [input];
    ld.param.u64 	    out_addr, [output];

    ld.b16              in16_0, [in_addr];
    ld.b16              in16_1, [in_addr+2];
    ld.b32              in32_0, [in_addr+4];
    ld.b32              in32_1, [in_addr+8];
	set.gtu.u32.f16     result0, in16_0, in16_1;
	set.gtu.u32.f16x2   result1, in32_0, in32_1;
    st.u32              [out_addr], result0;
    st.u32              [out_addr+4], result1;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 0, 126, 0, 126, 72, 66, 0, 252, 0, 128, 0, 0 };
.buffer OUT .u8 [8];
.launch set_f16 <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 255, 255, 255, 255, 255, 255, 0, 0 };
