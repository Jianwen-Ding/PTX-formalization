// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/activemask.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry activemask(
	.param .u64 input,
	.param .u64 output
)
{
    .reg .u64 	    out_addr;
    .reg .b32 	    temp;

    ld.param.u64 	out_addr, [output];

	activemask.b32  temp;
    st.u32          [out_addr], temp;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 0, 0, 0, 0 };
.buffer OUT .u8 [4];
.launch activemask <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 1, 0, 0, 0 };
