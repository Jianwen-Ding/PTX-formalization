// .target compute_80 is a synonym of sm_80 (11.1.2 L39091)
.version 7.0
.target compute_80
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o; .reg .b32 %r<4>;
    ld.param.u64 %o, [po];
    mov.u32 %r1, 5; redux.sync.add.u32 %r0, %r1, 0xffffffff;
    st.global.u32 [%o], %r0;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 32 >>> (OUT);
.expect OUT .u32 = { 160, 0, 0, 0 };
