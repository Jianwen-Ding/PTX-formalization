// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/setp_bool_and.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry setp_bool_and(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64       in_addr;
    .reg .u64       out_addr;
    .reg .u32       a, b, c_val, result;
    .reg .pred      p, c_pred;

    ld.param.u64    in_addr, [input];
    ld.param.u64    out_addr, [output];

    ld.u32          a, [in_addr];
    ld.u32          b, [in_addr + 4];
    ld.u32          c_val, [in_addr + 8];
    setp.ne.u32     c_pred, c_val, 0;
    setp.lt.and.u32 p, a, b, !c_pred;
    selp.u32        result, 1, 0, p;
    st.u32          [out_addr], result;

    ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 1, 0, 0, 0, 2, 0, 0, 0, 0, 0, 0, 0 };
.buffer OUT .u8 [4];
.launch setp_bool_and <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 1, 0, 0, 0 };
