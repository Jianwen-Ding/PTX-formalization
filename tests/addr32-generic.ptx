// Generic addressing under .address_size 32 (PTX ISA 6.4.1.1): generic addresses are 32-bit values and the
// .shared, .local and .const windows lie inside the 32-bit generic address space, so cvta to a .u32 register
// gives an address that reaches the variable and that isspacep classifies.
.version 8.0
.target sm_90
.address_size 32
.const .u32 cv = 9;
.visible .entry k(.param .u32 po)
{
    .reg .b32 %o, %g, %h, %c, %r<12>; .reg .pred %p;
    .shared .align 4 .b32 sh[4];
    .local .align 4 .b32 lo[2];
    ld.param.u32 %o, [po];
    st.shared.u32 [sh+4], 66;
    st.local.u32 [lo+4], 77;
    cvta.shared.u32 %g, sh;
    ld.u32 %r1, [%g+4];
    cvta.local.u32 %h, lo;
    ld.u32 %r2, [%h+4];
    cvta.const.u32 %c, cv;
    ld.u32 %r3, [%c];
    isspacep.shared %p, %g;  selp.u32 %r4, 1, 0, %p;
    isspacep.global %p, %g;  selp.u32 %r5, 1, 0, %p;
    isspacep.local %p, %h;   selp.u32 %r6, 1, 0, %p;
    isspacep.const %p, %c;   selp.u32 %r7, 1, 0, %p;
    isspacep.global %p, %o;  selp.u32 %r8, 1, 0, %p;
    cvta.to.shared.u32 %g, %g;
    ld.shared.u32 %r9, [%g+4];
    st.global.v4.u32 [%o], {%r1, %r2, %r3, %r4};
    st.global.v4.u32 [%o+16], {%r5, %r6, %r7, %r8};
    st.global.u32 [%o+32], %r9;
    ret;
}
.buffer OUT .u32 [9];
.launch k <<< 1, 1 >>> (OUT);
.expect OUT .u32 = { 66, 77, 9, 1, 0, 1, 1, 1, 66 };
