// mbarrier.try_wait resumes "following a system-dependent time limit" (9.7.14.16.19): with no other thread able to progress, it returns False and the thread can arrive itself
.version 9.3
.target sm_90
.address_size 64

.visible .entry k(.param .u64 po)
{
 .reg .b64 %o, %st, %st2, %mb, %g, %x; .reg .b32 %r<16>; .reg .pred %p, %q, %c;
 .shared .align 8 .b64 bar[4];
 .global .align 8 .b64 gbar[1];
 ld.param.u64 %o, [po];
 mov.u64 %mb, bar;
 cvta.shared.u64 %g, %mb;

 mbarrier.init.shared.b64 [%mb], 1;
 mov.u32 %r0, 0;
L: mbarrier.try_wait.parity.shared.b64 %p, [%mb], 0, 1000;
 @%p bra D;
 add.u32 %r0, %r0, 1;
 mbarrier.arrive.shared.b64 _, [%mb];
 bra L;
D: mov.u32 %r1, 1;
st.global.v4.b32 [%o], {%r0,%r1,%r2,%r3};
 ret;
}
.buffer O .u32 [8];
.launch k <<< 1, 1 >>> (O);
.expect O .u32 = {1,1,0,0};
