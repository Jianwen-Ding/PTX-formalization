// strict UB mode accepts aligned, in-bounds accesses (global, shared, local, vector)
.version 8.0
.target sm_90
.address_size 64
.ub strict ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %p; .reg .b32 %r<8>;
    .shared .align 16 .b8 sh[32];
    .local .align 8 .b8 lc[16];
    ld.param.u64 %o, [po];
    mov.u32 %r0, 5; mov.u32 %r1, 6; mov.u32 %r2, 7; mov.u32 %r3, 8;
    st.shared.v4.u32 [sh], {%r0, %r1, %r2, %r3};
    cvt.u64.u32 %p, %r0;
    st.local.u64 [lc+8], %p;
    ld.shared.u32 %r4, [sh+8];
    st.global.u32 [%o+4], %r4;
    st.global.u32 [%o], %r1;
    ret;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 1 >>> (OUT);
.expect OUT .u32 = { 6, 7, 0, 0 };
