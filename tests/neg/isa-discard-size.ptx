// expect: discard: the only supported size is 128
// discard (9.7.9.18): the size operand must be 128 (.isacheck)
.version 8.0
.target sm_80
.address_size 64
.isacheck ;
.global .align 256 .b8 g[512];
.shared .align 16 .b8 s[16];
.visible .entry k()
{
    .reg .b64 %a;
    mov.u64 %a, g; discard.global.L2 [%a], 64;
    ret;
}
.launch k <<< 1, 1 >>> ();
