// .convergence its: activemask returns the lanes that reached it so far, always including the caller and only lanes of the warp
.version 8.0
.target sm_90
.address_size 64
.convergence its ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %a; .reg .b32 %t, %m, %s, %ok; .reg .pred %p;
    ld.param.u64 %o, [po];
    mov.u32 %t, %tid.x;
    activemask.b32 %m;
    shr.u32 %s, %m, %t;
    and.b32 %ok, %s, 1;
    setp.lt.u32 %p, %m, 16;
    @%p add.u32 %ok, %ok, 2;
    mul.wide.u32 %a, %t, 4;
    add.u64 %a, %o, %a;
    st.global.u32 [%a], %ok;
    ret;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 4 >>> (OUT);
.expect OUT .u32 = { 3, 3, 3, 3 };
