# Generated by scripts/nvmm.py --write from NVlabs/mixedproxy tests/*.test (BSD-3-Clause, NVIDIA).
# One test per template instance and permit/assert command; `expect` is the nvlitmus expectation.
# Not run by `make memmodel` (subdirectory); see docs/review-checklist.md for the disagreements.

test CoMP_volatile:check_r1
desc mixedproxy permit(r1 != 2)
init x=0
thread T0_0_0 cta=0 cluster=0 gpu=0
  st.weak x 1
  st.volatile x 2
thread T0_1_0 cta=1 cluster=0 gpu=0
  r0 = ld.weak x
  r1 = ld.volatile x
exists r0==2 && r1!=2
expect allowed

test CoWR-1:r0
desc mixedproxy assert(r0 == 1)
init x=0
thread T0_0_0 cta=0 cluster=0 gpu=0
  st.weak x 1
  r0 = ld.weak x
exists r0!=1
expect forbidden

