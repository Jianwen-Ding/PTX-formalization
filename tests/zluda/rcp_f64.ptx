// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/rcp_f64.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry rcp_f64(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .f64 	    temp;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.f64          temp, [in_addr];
	rcp.rz.f64  temp, temp;
    st.f64          [out_addr], temp;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 0, 0, 0, 0, 0, 0, 0, 64 };
.buffer OUT .u8 [8];
.launch rcp_f64 <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 0, 0, 0, 0, 0, 0, 224, 63 };
