// Message passing (MP): allowed with relaxed accesses (stores may be reordered)
// Producer: data = 1; flag = 1        Consumer: rf = flag; rd = data        weak outcome: rf == 1 && rd == 0
// `.expect` encodes the weak outcome, so exit code 0 means "the weak outcome is reachable":
//   krun -d build/ptx-kompiled examples/litmus-mp.ptx --search --pattern '<exit-code> X:Int </exit-code>'
.version 8.0
.target sm_90
.address_size 64

.global .align 4 .u32 data;
.global .align 4 .u32 flag;
.global .align 4 .u32 rf;
.global .align 4 .u32 rd;

.visible .entry k()
{
    .reg .b32 %t, %v, %w, %one; .reg .pred %p;
    mov.u32 %one, 1;
    mov.u32 %t, %tid.x;
    setp.eq.u32 %p, %t, 0;
    @%p bra PROD;
    ld.relaxed.gpu.global.u32 %v, [flag];
    ld.relaxed.gpu.global.u32 %w, [data];
    st.global.u32 [rf], %v;
    st.global.u32 [rd], %w;
    ret;
PROD:
    st.relaxed.gpu.global.u32 [data], %one;
    st.relaxed.gpu.global.u32 [flag], %one;
    ret;
}

.memmodel relaxed ;
.launch k <<< 1, 2 >>> ();
.expect rf .u32 = { 1 };
.expect rd .u32 = { 0 };
