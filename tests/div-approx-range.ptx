// PTX ISA 9.3 9.7.3.8: "For 2^126 < |b| < 2^128, if a is infinity, div.approx.f32 returns NaN, otherwise it returns a
// sign-preserving zero" (d = a * (1/b)); the exact quotients here would be 2^-127, -3 * 2^-127, ..., 0x3FFFFFFF.
.version 8.0
.target sm_80
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .f32 %f<16>; .reg .b64 %o;
    ld.param.u64 %o, [po];
    mov.b32 %f1, 0x3F800000; mov.b32 %f2, 0x7F000000;   // 1 / 2^127
    div.approx.f32 %f3, %f1, %f2;
    mov.b32 %f1, 0xC0400000;                             // -3 / 2^127
    div.approx.f32 %f4, %f1, %f2;
    mov.b32 %f1, 0x7F800000; mov.b32 %f5, 0xFEC00000;   // +Inf / -1.5 * 2^126
    div.approx.f32 %f6, %f1, %f5;
    mov.b32 %f1, 0x40A00000; mov.b32 %f5, 0xFF7FFFFF;   // 5 / -MAX
    div.approx.ftz.f32 %f7, %f1, %f5;
    mov.b32 %f1, 0x80000000; mov.b32 %f5, 0x7F7FFFFF;   // -0 / MAX
    div.approx.f32 %f8, %f1, %f5;
    mov.b32 %f1, 0x7F7FFFFF;                             // MAX / 2^127
    div.approx.f32 %f9, %f1, %f2;
    mov.b32 %f1, 0xFF800000; mov.b32 %f5, 0x7F7FFFFF;   // -Inf / MAX
    div.approx.ftz.f32 %f10, %f1, %f5;
    st.global.v4.f32 [%o], {%f3, %f4, %f6, %f7};
    st.global.v2.f32 [%o+16], {%f8, %f9};
    st.global.f32 [%o+24], %f10;
    ret;
}
.buffer OUT .u32 [7];
.launch k <<< 1, 1 >>> (OUT);
.expect OUT .u32 = { 0x00000000, 0x80000000, 0x7FFFFFFF, 0x80000000, 0x80000000, 0x00000000, 0x7FFFFFFF };
