    ("p=mma m=f16/f32", "0:70", "9.7.16.4.5"),
    ("p=mma m=u8/s8/s32", "0:72", "9.7.16.4.5"),
    ("p=mma m=u4/s4/b1/m8n8k32/m8n8k128", "0:75", "9.7.16.4.5"),
    ("p=mma m=f64/bf16/tf32/m16n16k8", "0:80", "9.7.16.4.5"),
    ("p=mma m=and", "0:80", "9.7.16.4.5")|],
  "xor" => [|("", "10:", "9.7.9.3")|],
  _ => [||]
}

/* 11.1.2: the PTX ISA version (x10) that introduced a target string; -1 for an unknown one */
