// expect: brkpt: execution suspended
// brkpt "Suspends execution" (9.7.20.1); the model has no debugger to resume, so the run stops there
.version 8.0
.target sm_80
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o;
    ld.param.u64 %o, [po];
    brkpt;
    st.global.u32 [%o], 1;
    ret;
}
.buffer O .u32 [1];
.launch k <<< 1, 1 >>> (O);
