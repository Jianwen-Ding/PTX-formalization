// ld.global.nc .v8.u32 / .v4.u64 with sink elements '_' (9.7.9.9: "data from corresponding memory location is not read")
.version 8.8
.target sm_100
.address_size 64
.visible .entry k(.param .u64 pi, .param .u64 po)
{
    .reg .b32 %r<8>; .reg .b64 %i, %o, %d<4>;
    ld.param.u64 %i, [pi]; ld.param.u64 %o, [po];
    ld.global.nc.v8.u32 {%r0, _, %r2, %r3, _, %r5, %r6, %r7}, [%i];
    ld.global.nc.v4.u64 {%d0, _, %d2, %d3}, [%i];
    st.global.v4.u32 [%o], {%r0, %r2, %r3, %r5};
    st.global.v2.u32 [%o+16], {%r6, %r7};
    st.global.v2.u64 [%o+24], {%d0, %d3};
    ret;
}
.buffer I .u32 = { 1, 2, 3, 4, 5, 6, 7, 8 };
.buffer O .u32 [10];
.launch k <<< 1, 1 >>> (I, O);
.expect O .u32 = { 1, 3, 4, 6, 7, 8, 1, 2, 7, 8 };
