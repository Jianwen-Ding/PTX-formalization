test ISA2:outcome
desc mixedproxy assert(r2 == 42)
init flag1=0 flag2=0 x=0
thread T0_0_0 cta=0 cluster=0 gpu=0
  st.weak x 42
  st.release.cta flag1 1
thread T0_0_1 cta=0 cluster=0 gpu=0
  r0 = ld.acquire.cta flag1
  st.release.gpu flag2 1
thread T0_1_0 cta=1 cluster=0 gpu=0
  r1 = ld.acquire.gpu flag2
  r2 = ld.weak x
exists r0==1 && r1==1 && r2!=42
expect forbidden

