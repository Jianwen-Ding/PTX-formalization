// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/sink.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry sink(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
	.reg .u64 	    out_addr;
	.reg .b64 	    temp;
	.reg .u32 	    lo;
	.reg .u32 	    hi;
	.reg .u32 	    z;

	ld.param.u64 	in_addr, [input];
	ld.param.u64 	out_addr, [output];

	ld.b64          temp, [in_addr];
	mov.b64         {_, _}, temp;
	mov.b64         {lo, _}, temp;
	mov.b64         {_, hi}, temp;
	ld.v4.u32       {_, _, z, _}, [in_addr];
	ld.v4.u32       {_, _, _, _}, [in_addr];
	st.u32          [out_addr], hi;
	st.u32          [out_addr+4], lo;
	st.u32          [out_addr+8], z;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 1, 0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0, 4, 0, 0, 0 };
.buffer OUT .u8 [12];
.launch sink <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 2, 0, 0, 0, 1, 0, 0, 0, 3, 0, 0, 0 };
