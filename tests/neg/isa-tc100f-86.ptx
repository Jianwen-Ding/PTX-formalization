// expect: target sm_103a needs PTX ISA 8.8
// tcgen05.fence on sm_103a with PTX 8.6: sm_103a appears in PTX 8.8 (11.1.2 L39134)
.version 8.6
.target sm_103a
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %rd<4>; .reg .b32 %r<16>; .reg .f32 %f<8>; .reg .b16 %h<4>; .reg .pred %p; .shared .b64 mb;
    ld.param.u64 %o, [po];
    mov.u32 %r0, 7;
    tcgen05.fence::before_thread_sync;
    st.global.u32 [%o], %r0;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 1 >>> (OUT);
