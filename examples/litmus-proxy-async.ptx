// Generic-proxy store followed by an async-proxy bulk copy of the same shared word, no proxy fence:
// the copy may read the stale value.  Weak outcome (encoded by .expect): the copy delivered the old value 0.
.version 8.0
.target sm_90
.address_size 64

.global .align 16 .b8 dst[16];
.global .align 4 .u32 r0;

.visible .entry k()
{
    .shared .align 16 .b8 buf[16];
    .reg .b32 %v, %z, %one;
    mov.u32 %z, 0;
    mov.u32 %one, 1;
    st.shared.u32 [buf], %z;
    fence.sc.cta;
    st.shared.u32 [buf], %one;
    cp.async.bulk.global.shared::cta.bulk_group [dst], [buf], 16;
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group 0;
    ld.global.u32 %v, [dst];
    st.global.u32 [r0], %v;
    ret;
}

.memmodel relaxed ;
.launch k <<< 1, 1 >>> ();
.expect r0 .u32 = { 0 };
