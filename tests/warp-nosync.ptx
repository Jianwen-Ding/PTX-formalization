// deprecated shfl / vote without .sync (targets below sm_70): exchange among the active lanes; an inactive lane
// contributes 0 to vote.ballot (9.7.8.x shfl (deprecated), vote (deprecated))
.version 6.0
.target sm_60
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .b32 %r<6>, %t; .reg .b64 %o, %a; .reg .pred %q, %p, %odd;
    ld.param.u64 %o, [po];
    mov.u32 %t, %laneid;
    setp.lt.u32 %q, %t, 4;
    vote.ballot.b32 %r0, %q;
    shfl.down.b32 %r1|%p, %t, 1, 0x1f;
    selp.u32 %r2, 1, 0, %p;
    vote.all.pred %p, %q;
    selp.u32 %r3, 1, 0, %p;
    and.b32 %r4, %t, 1; setp.eq.u32 %odd, %r4, 1;
    mov.u32 %r5, 0;
    @%odd vote.ballot.b32 %r5, %q;
    mul.wide.u32 %a, %t, 20; add.u64 %a, %a, %o;
    st.global.u32 [%a], %r0; st.global.u32 [%a+4], %r1; st.global.u32 [%a+8], %r2; st.global.u32 [%a+12], %r3; st.global.u32 [%a+16], %r5;
    ret;
}
.buffer O .u32 [160];
.launch k <<< 1, 32 >>> (O);
.expect O .u32 = { 15, 1, 1, 0, 0, 15, 2, 1, 0, 10, 15, 3, 1, 0, 0, 15, 4, 1, 0, 10, 15, 5, 1, 0, 0, 15, 6, 1, 0, 10, 15, 7, 1, 0, 0, 15, 8, 1, 0, 10, 15, 9, 1, 0, 0, 15, 10, 1, 0, 10, 15, 11, 1, 0, 0, 15, 12, 1, 0, 10, 15, 13, 1, 0, 0, 15, 14, 1, 0, 10, 15, 15, 1, 0, 0, 15, 16, 1, 0, 10, 15, 17, 1, 0, 0, 15, 18, 1, 0, 10, 15, 19, 1, 0, 0, 15, 20, 1, 0, 10, 15, 21, 1, 0, 0, 15, 22, 1, 0, 10, 15, 23, 1, 0, 0, 15, 24, 1, 0, 10, 15, 25, 1, 0, 0, 15, 26, 1, 0, 10, 15, 27, 1, 0, 0, 15, 28, 1, 0, 10, 15, 29, 1, 0, 0, 15, 30, 1, 0, 10, 15, 31, 1, 0, 0, 15, 31, 0, 0, 10 };
