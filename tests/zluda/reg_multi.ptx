// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/reg_multi.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry reg_multi(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .u32       a, b;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.u32   a, [in_addr];
    ld.u32   b, [in_addr+4];
    st.u32   [out_addr], a;
    st.u32   [out_addr+4], b;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 123, 0, 0, 0, 200, 1, 0, 0 };
.buffer OUT .u8 [8];
.launch reg_multi <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 123, 0, 0, 0, 200, 1, 0, 0 };
