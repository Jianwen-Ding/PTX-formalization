// launch constraints that hold: .maxntid, .reqntid (on separate kernels: "The .reqntid directive cannot be used in
// conjunction with the .maxntid directive", 11.4.3) and a 3-D block
.version 8.0
.target sm_90
.address_size 64
.global .align 4 .u32 r;
.global .align 4 .u32 s;
.visible .entry k() .reqntid 32, 2, 1
{
    .reg .b32 %t;
    mov.u32 %t, %ntid.x;
    st.global.u32 [r], %t;
    ret;
}
.visible .entry k2() .maxntid 64, 4, 1
{
    .reg .b32 %t;
    mov.u32 %t, %ntid.y;
    st.global.u32 [s], %t;
    ret;
}
.launch k <<< 2, (32, 2) >>> ();
.launch k2 <<< 1, (16, 4, 2) >>> ();
.expect r .u32 = { 32 };
.expect s .u32 = { 4 };
