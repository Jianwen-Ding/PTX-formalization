// expect: needs target sm_90
// add.bf16 requires sm_90 (9.7.4.1 L9933)
.version 7.8
.target sm_80
.address_size 64
.isacheck ;
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %rd<4>; .reg .b32 %r<16>; .reg .f32 %f<8>; .reg .b16 %h<4>; .reg .pred %p; .shared .b64 mb;
    ld.param.u64 %o, [po];
    mov.u32 %r0, 7;
    add.rn.bf16 %h0, %h1, %h2;
    st.global.u32 [%o], %r0;
}

.buffer OUT .u32 [4];
.launch k <<< 1, 1 >>> (OUT);
