// legal qualifier combinations under .isacheck: add.f32x2 on sm_100 / PTX 8.6, add.u8x4 on PTX 9.2, shfl.sync
.version 9.2
.target sm_100a
.address_size 64
.isacheck ;
.global .align 4 .u32 r;
.visible .entry k()
{
    .reg .b32 %a, %b, %c; .reg .b64 %d<3>;
    mov.b32 %a, 0x01010101; mov.b32 %b, 0x02020202;
    add.u8x4 %c, %a, %b;
    add.f32x2 %d0, %d1, %d2;
    shfl.sync.up.b32 %a, %b, 1, 0, 0xffffffff;
    st.global.u32 [r], %c;
    ret;
}
.launch k <<< 1, 1 >>> ();
.expect r .u32 = { 50529027 };
