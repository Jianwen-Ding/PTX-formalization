// cvt additions (PTX ISA 9.1 / 9.4): .rz and .pzo on the narrow formats, .scaled::n1/n2::ue8m0, .ue5m3x2 and .s2f6x2
.version 9.4
.target sm_107f
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o; .reg .b32 %r<8>, %s; .reg .b16 %h<4>; .reg .f32 %a, %b, %c, %d;
    ld.param.u64 %o, [po];
    mov.b32 %s, 0x3f8ccccd; mov.b32 %a, %s;            // 1.1
    cvt.rn.satfinite.e4m3x2.f32 %h0, %a, %a;           // 0x3939
    cvt.u32.u16 %r0, %h0;
    cvt.rz.satfinite.e4m3x2.f32 %h0, %a, %a;           // 0x3838
    cvt.u32.u16 %r1, %h0;
    mov.b32 %s, 0xaedbe6ff; mov.b32 %b, %s;            // -1e-10 (rounds to -0)
    cvt.rn.satfinite.pzo.e4m3x2.f32 %h0, %b, %b;       // +0
    cvt.u32.u16 %r2, %h0;
    cvt.rn.satfinite.e4m3x2.f32 %h0, %b, %b;           // -0 = 0x80
    cvt.u32.u16 %r3, %h0;
    mov.b32 %s, 0x40400000; mov.b32 %c, %s;            // 3.0
    mov.b32 %s, 0x3f800000; mov.b32 %d, %s;            // 1.0
    mov.b16 %h1, 0x80;                                 // scale 2^1
    cvt.rn.satfinite.scaled::n1::ue8m0.e4m3x2.f32 %h0, %c, %c, %h1;
    cvt.u32.u16 %r4, %h0;
    cvt.rn.satfinite.ue5m3x2.f32 %h2, %c, %d;
    cvt.u32.u16 %r5, %h2;
    cvt.rn.satfinite.s2f6x2.f32 %h0, %d, %c;           // 1.0 -> 0x40, 3.0 saturates to 0x7f
    cvt.u32.u16 %r6, %h0;
    st.global.u32 [%o], %r0;
    st.global.u32 [%o+4], %r1;
    st.global.u32 [%o+8], %r2;
    st.global.u32 [%o+12], %r3;
    st.global.u32 [%o+16], %r4;
    st.global.u32 [%o+20], %r5;
    st.global.u32 [%o+24], %r6;
    ret;
}
.buffer OUT .u32 [7];
.launch k <<< 1, 1 >>> (OUT);
.expect OUT .u32 = { 14649, 14392, 0, 32896, 15420, 33912, 16511 };
