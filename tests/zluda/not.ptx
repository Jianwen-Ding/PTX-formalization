// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/not.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry not(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .u64 	    temp;
    .reg .u64 	    temp2;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.u64          temp, [in_addr];
	not.b64		    temp2, temp;
    st.u64          [out_addr], temp2;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 0, 0, 0, 0, 0, 0, 0, 0 };
.buffer OUT .u8 [8];
.launch not <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 255, 255, 255, 255, 255, 255, 255, 255 };
