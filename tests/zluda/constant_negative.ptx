// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/constant_negative.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry constant_negative(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .s32 	    temp;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.s32          temp, [in_addr];
	mul.lo.s32		temp, temp, -1;
    st.s32          [out_addr], temp;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 155, 255, 255, 255 };
.buffer OUT .u8 [4];
.launch constant_negative <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 101, 0, 0, 0 };
