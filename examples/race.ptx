// A data race: two threads increment a global counter with a plain
// load/add/store.  The default `krun` run follows one schedule (which here
// happens to lose an update);
// `krun --search` explores every interleaving and finds the lost update.
//
//   krun -d build/ptx-kompiled examples/race.ptx --search \
//        --pattern '<exit-code> 1 </exit-code>'
.version 8.0
.target sm_80
.address_size 64

.global .align 4 .u32 counter;

.visible .entry racy_inc()
{
    .reg .b32 %r<3>;
    ld.global.u32   %r1, [counter];
    add.u32         %r2, %r1, 1;
    st.global.u32   [counter], %r2;
    ret;
}

.launch racy_inc <<< 1, 2 >>> ();
.expect counter .u32 = { 2 };
