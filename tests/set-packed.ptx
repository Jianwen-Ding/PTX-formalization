// set.CmpOp.{u8x4,s8x4,u16x2,s16x2} (PTX ISA 9.4): lane-wise masks
.version 9.4
.target sm_90
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o; .reg .b32 %a, %b, %r<4>;
    ld.param.u64 %o, [po];
    mov.b32 %a, 0x80017f02; mov.b32 %b, 0x01017f03;
    set.lt.u8x4 %r0, %a, %b;       // 0x000000ff
    set.lt.s8x4 %r1, %a, %b;       // 0xff0000ff
    set.eq.u16x2 %r2, %a, %b;      // no lane equal
    set.ge.s16x2 %r3, %a, %b;      // lane0 0x7f02 >= 0x7f03 false; lane1 negative vs positive false
    st.global.u32 [%o], %r0;
    st.global.u32 [%o+4], %r1;
    st.global.u32 [%o+8], %r2;
    st.global.u32 [%o+12], %r3;
    ret;
}
.buffer OUT .u32 [4];
.launch k <<< 1, 1 >>> (OUT);
.expect OUT .u32 = { 255, 4278190335, 0, 0 };
