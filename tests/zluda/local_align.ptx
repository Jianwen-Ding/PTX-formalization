// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/local_align.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry local_align(
	.param .u64 input,
	.param .u64 output
)
{
    .local .align 8 .b8 __local_depot0[8];
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .u64 	    temp;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.u64          temp, [in_addr];
    st.u64          [out_addr], temp;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 1, 0, 0, 0, 0, 0, 0, 0 };
.buffer OUT .u8 [8];
.launch local_align <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 1, 0, 0, 0, 0, 0, 0, 0 };
