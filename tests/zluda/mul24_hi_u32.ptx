// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/mul24_hi_u32.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry mul24_hi_u32(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .u32 	    temp;
    .reg .u32 	    temp2;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.u32          temp, [in_addr];
	mul24.hi.u32		temp2, temp, temp;
    st.u32          [out_addr], temp2;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 85, 85, 117, 0 };
.buffer OUT .u8 [4];
.launch mul24_hi_u32 <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 35, 28, 199, 53 };
