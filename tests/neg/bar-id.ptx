// expect: barrier id outside 0..15
// 9.7.14.1: sixteen barriers numbered 0..15; any other id names no barrier
.version 8.0
.target sm_90
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .u32 %r; .reg .b64 %o;
    ld.param.u64 %o, [po];
    mov.u32 %r, 20;
    bar.sync %r;
    st.global.u32 [%o], 1;
    ret;
}
.buffer O .u32 [1];
.launch k <<< 1, 32 >>> (O);
