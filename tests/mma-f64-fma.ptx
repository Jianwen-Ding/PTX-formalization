// f64 mma: "Precision of the element-wise multiplication and addition operation is identical to that of .f64 precision
// fused multiply-add" (9.7.15.5.14): each A row is (1, 2^-53, 2^-53, 0), B is all ones, C = 0.  A chain of f64 fmas
// gives 1 + 2^-53 -> 1 (tie to even) twice, so D = 1.0; rounding the exact sum once would give 1 + 2^-52
.version 8.0
.target sm_90
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .f64 %a, %b, %c<2>, %d<2>; .reg .b32 %l, %g; .reg .b64 %o, %p; .reg .pred %z, %t;
    ld.param.u64 %o, [po];
    mov.u32 %l, %laneid;
    and.b32 %g, %l, 3;
    setp.eq.u32 %z, %g, 0; setp.eq.u32 %t, %g, 3;
    mov.f64 %a, 0d3CA0000000000000;
    @%z mov.f64 %a, 0d3FF0000000000000;
    @%t mov.f64 %a, 0d0000000000000000;
    mov.f64 %b, 0d3FF0000000000000;
    mov.f64 %c0, 0d0000000000000000; mov.f64 %c1, 0d0000000000000000;
    mma.sync.aligned.m8n8k4.row.col.f64.f64.f64.f64 {%d0, %d1}, {%a}, {%b}, {%c0, %c1};
    mul.wide.u32 %p, %l, 16; add.u64 %p, %p, %o;
    st.global.v2.f64 [%p], {%d0, %d1};
    ret;
}
.buffer O .u64 [64];
.launch k <<< 1, 32 >>> (O);
.expect O .u64 = { 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000 };
