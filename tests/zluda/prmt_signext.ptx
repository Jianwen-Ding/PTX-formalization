// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/prmt_signext.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry prmt_signext(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
	.reg .u64 	    out_addr;
	.reg .u32 	    x_val;
	.reg .u32 	    y_val;
	.reg .u32 	    result;

	ld.param.u64 	in_addr, [input];
	ld.param.u64 	out_addr, [output];

	ld.u32          x_val, [in_addr];
	ld.u32          y_val, [in_addr+4];
	prmt.b32        result, x_val, y_val, 0x0A08;
	st.u32          [out_addr], result;
	ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 128, 254, 0, 1, 0, 0, 0, 0 };
.buffer OUT .u8 [4];
.launch prmt_signext <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 255, 128, 0, 128 };
