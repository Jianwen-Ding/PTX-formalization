// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/stateful_ld_st_ntid_chain.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_30
.address_size 64

.visible .entry stateful_ld_st_ntid_chain(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .b64           in_addr1;
    .reg .b64           in_addr2;
    .reg .b64           in_addr3;
    .reg .b64           out_addr1;
    .reg .b64           out_addr2;
    .reg .b64           out_addr3;
    .reg .u32           tid_32;
    .reg .u64           tid_64;
    .reg .u64           temp;

    ld.param.u64        in_addr1, [input];
    ld.param.u64        out_addr1, [output];

    cvta.to.global.u64  in_addr2, in_addr1;
    cvta.to.global.u64  out_addr2, out_addr1;

    mov.u32             tid_32, %tid.x;
    cvt.u64.u32         tid_64, tid_32;

    add.u64             in_addr3, in_addr2, tid_64;
    add.u64             out_addr3, out_addr2, tid_64;

    ld.global.u64       temp, [in_addr3];
    st.global.u64       [out_addr3], temp;
    ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 107, 49, 0, 0, 0, 0, 0, 0 };
.buffer OUT .u8 [8];
.launch stateful_ld_st_ntid_chain <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 107, 49, 0, 0, 0, 0, 0, 0 };
