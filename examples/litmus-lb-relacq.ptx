// Load buffering (LB): forbidden with acquire loads and release stores
// Thread 0: r0 = x; y = 1        Thread 1: r1 = y; x = 1        weak outcome: r0 == 1 && r1 == 1
// `.expect` encodes the weak outcome, so exit code 0 means "the weak outcome is reachable":
//   krun -d build/ptx-kompiled examples/litmus-lb-relacq.ptx --search --pattern '<exit-code> X:Int </exit-code>'
.version 8.0
.target sm_90
.address_size 64

.global .align 4 .u32 x;
.global .align 4 .u32 y;
.global .align 4 .u32 r0;
.global .align 4 .u32 r1;

.visible .entry k()
{
    .reg .b32 %t, %v, %one; .reg .pred %p;
    mov.u32 %one, 1;
    mov.u32 %t, %tid.x;
    setp.eq.u32 %p, %t, 0;
    @%p bra T0;
    ld.acquire.gpu.global.u32 %v, [y];
    st.release.gpu.global.u32 [x], %one;
    st.global.u32 [r1], %v;
    ret;
T0:
    ld.acquire.gpu.global.u32 %v, [x];
    st.release.gpu.global.u32 [y], %one;
    st.global.u32 [r0], %v;
    ret;
}

.memmodel relaxed ;
.launch k <<< 1, 2 >>> ();
.expect r0 .u32 = { 1 };
.expect r1 .u32 = { 1 };
