// expect: setmaxnreg.inc below the warp's current register count
// setmaxnreg.inc with a count below the warp's current maximum is undefined (9.7.20.5), reported under .ub strict
.version 8.0
.target sm_90a
.address_size 64
.ub strict ;
.visible .entry k()
{
    setmaxnreg.inc.sync.aligned.u32 232;
    setmaxnreg.inc.sync.aligned.u32 200;
    ret;
}
.launch k <<< 1, 128 >>> ();
