// Indirect calls through function pointers (prototype and .calltargets forms) and brx.idx.
.version 8.6
.target sm_90
.address_size 64

.func (.param .u32 rv) f1 (.param .u32 a)
{
    .reg .u32 t;
    ld.param.u32 t, [a];
    add.u32 t, t, 1;
    st.param.u32 [rv], t;
    ret;
}
.func (.param .u32 rv) f2 (.param .u32 a)
{
    .reg .u32 t;
    ld.param.u32 t, [a];
    mul.lo.u32 t, t, 10;
    st.param.u32 [rv], t;
    ret;
}
.global .u64 ftab[2] = { f1, f2 };

.visible .entry k(.param .u64 po)
{
    .reg .u64 %o, %fp, %tb; .reg .u32 %x, %y, %i, %r<6>, %sel; .reg .pred %p;
    .param .u32 pa;
    .param .u32 prv;
    Fproto: .callprototype (.param .u32 _) _ (.param .u32 _);
    Ftargets: .calltargets f1, f2;
    Btab: .branchtargets L0, L1, L2;
    ld.param.u64 %o, [po];
    mov.u32 %x, 5;
    // via a function address in a register
    mov.u64 %fp, f2;
    st.param.u32 [pa], %x;
    call (prv), %fp, (pa), Fproto;
    ld.param.u32 %r0, [prv];
    // via the table in global memory
    mov.u64 %tb, ftab;
    ld.global.u64 %fp, [%tb];
    st.param.u32 [pa], %x;
    call (prv), %fp, (pa), Ftargets;
    ld.param.u32 %r1, [prv];
    ld.global.u64 %fp, [%tb+8];
    st.param.u32 [pa], %x;
    call (prv), %fp, (pa), Ftargets;
    ld.param.u32 %r2, [prv];
    // brx.idx
    mov.u32 %i, 2;
    brx.idx %i, Btab;
L0: mov.u32 %r3, 100;
    bra DONE;
L1: mov.u32 %r3, 101;
    bra DONE;
L2: mov.u32 %r3, 102;
DONE:
    st.global.u32 [%o], %r0;
    st.global.u32 [%o+4], %r1;
    st.global.u32 [%o+8], %r2;
    st.global.u32 [%o+12], %r3;
    ret;
}
.buffer O .u32 [4];
.launch k <<< 1, 1 >>> (O);
.expect O .u32 = { 50, 6, 50, 102 };
