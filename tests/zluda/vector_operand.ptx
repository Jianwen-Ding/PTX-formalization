// From ZLUDA (https://github.com/vosen/ZLUDA, MIT OR Apache-2.0), ptx/src/test/spirv_run/vector_operand.ptx;
// inputs/outputs from its mod.rs test table.
.version 6.5
.target sm_60
.address_size 64

.visible .entry vector_operand(
    .param .u64 input_p,
    .param .u64 output_p
)
{
    .reg .u64    in_addr;
    .reg .u64    out_addr;

    .reg .b16    in;
    .reg .b32    out;

    ld.param.u64 in_addr, [input_p];
    ld.param.u64 out_addr, [output_p];

    ld.b16       in, [in_addr];

    mov.b32      out, {0x5678, in};

    st.b32       [out_addr], out;
    ret;
}

// ---- harness (generated by scripts/import_zluda.py) ----
.buffer IN .u8 = { 52, 18 };
.buffer OUT .u8 [4];
.launch vector_operand <<< 1, 1 >>> (IN, OUT);
.expect OUT .u8 = { 120, 86, 52, 18 };
